{
  "uid": "holdmytrack-overview",
  "title": "HoldMyTrack",
  "tags": [
    "holdmytrack"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / min",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROM}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "sum(rate(holdmytrack_http_requests_total{deployment=\"${DEPLOYMENT}\"}[5m])) * 60",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "5xx, last hour",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROM}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "sum(increase(holdmytrack_http_requests_total{deployment=\"${DEPLOYMENT}\", class=\"5xx\"}[1h]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Runnable jobs",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROM}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "sum(holdmytrack_jobs_runnable{deployment=\"${DEPLOYMENT}\"})",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Oldest job waiting",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROM}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "max(holdmytrack_jobs_oldest_runnable_age_seconds{deployment=\"${DEPLOYMENT}\"})",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Last backup / reference",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROM}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "time() - max(holdmytrack_backup_last_success_timestamp_seconds{deployment=\"${DEPLOYMENT}\"})",
          "instant": true,
          "legendFormat": "nightly"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "time() - max(holdmytrack_backup_reference_timestamp_seconds{deployment=\"${DEPLOYMENT}\"})",
          "instant": true,
          "legendFormat": "reference"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 93600
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "blue",
                      "value": null
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "description": "Time since backup.sh last succeeded at night, and since the reference dump in the bucket was taken: that one changes only with an import or a seed, so months is normal."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Disk used",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROM}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "max(1 - node_filesystem_avail_bytes{deployment=\"${DEPLOYMENT}\", fstype=~\"ext4|xfs|btrfs\"} / node_filesystem_size_bytes{deployment=\"${DEPLOYMENT}\", fstype=~\"ext4|xfs|btrfs\"})",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 0.85
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "API responses by status",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROM}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "sum by (class) (rate(holdmytrack_http_requests_total{deployment=\"${DEPLOYMENT}\"}[5m])) * 60",
          "legendFormat": "{{class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Slowest routes, p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROM}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "topk(5, histogram_quantile(0.95, sum by (route, le) (rate(holdmytrack_http_request_duration_seconds_bucket{deployment=\"${DEPLOYMENT}\"}[15m]))))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Job queue",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROM}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "sum by (kind) (holdmytrack_jobs_runnable{deployment=\"${DEPLOYMENT}\"})",
          "legendFormat": "{{kind}} runnable"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "max by (kind) (holdmytrack_jobs_oldest_runnable_age_seconds{deployment=\"${DEPLOYMENT}\"}) / 60",
          "legendFormat": "{{kind}} oldest, min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Jobs finished",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROM}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "sum by (kind, outcome, code) (increase(holdmytrack_jobs_finished_total{deployment=\"${DEPLOYMENT}\"}[15m]))",
          "legendFormat": "{{kind}} {{outcome}} {{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Per 15 minutes. A failed job with code internal is ours; any other code is the user's file."
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Memory",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROM}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "node_memory_MemTotal_bytes{deployment=\"${DEPLOYMENT}\"} - node_memory_MemAvailable_bytes{deployment=\"${DEPLOYMENT}\"}",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "node_memory_SwapTotal_bytes{deployment=\"${DEPLOYMENT}\"} - node_memory_SwapFree_bytes{deployment=\"${DEPLOYMENT}\"}",
          "legendFormat": "swap used"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "node_memory_MemTotal_bytes{deployment=\"${DEPLOYMENT}\"}",
          "legendFormat": "total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROM}"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "1 - avg(rate(node_cpu_seconds_total{deployment=\"${DEPLOYMENT}\", mode=\"idle\"}[5m]))",
          "legendFormat": "busy"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "node_load1{deployment=\"${DEPLOYMENT}\"}",
          "legendFormat": "load 1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Postgres",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROM}"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "sum(pg_stat_database_numbackends{deployment=\"${DEPLOYMENT}\"})",
          "legendFormat": "connections"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROM}"
          },
          "expr": "sum(pg_database_size_bytes{deployment=\"${DEPLOYMENT}\"}) / 1e9",
          "legendFormat": "size, GB"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "type": "logs",
      "title": "Errors (api, worker, db)",
      "datasource": {
        "type": "loki",
        "uid": "${LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${LOKI}"
          },
          "expr": "{deployment=\"${DEPLOYMENT}\", service=~\"api|worker\", level=\"ERROR\"}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "${LOKI}"
          },
          "expr": "{deployment=\"${DEPLOYMENT}\", service=\"db\"} |~ \"ERROR|FATAL|PANIC\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
