          },
          "expr": "max(holdmytrack_r2_budget_used_ratio{deployment=\"${DEPLOYMENT}\"})",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.7
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Today's (UTC) requests to the app's bucket at R2 list prices, as a share of R2_DAILY_BUDGET_USD. Renders stop at 70%, adding at 85%, the map's stored tiles at 100% (ADR-0044)."
