<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The map is served, not bundled: both the style document and every basemap tile come
         from the API. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Exactly two Health Connect permissions, and no more. Declaring types the product does
      not demonstrably use is a known Play rejection cause (docs/VISION.md §7), so heart rate,
      distance, calories and the rest stay out: HoldMyTrack ingests outdoor GPS routes, and a route
      needs the session and its geometry, nothing else.

      READ_HEALTH_DATA_IN_BACKGROUND is deliberately absent. Phase 1 measured that it buys
      nothing for routes — the same 46 sessions returned 23 routes in the foreground and 0 in
      the background with it granted — so requesting it would be asking the user for an
      alarming permission that cannot change what the app can do.

      READ_EXERCISE_ROUTES cannot be requested programmatically at all: the platform only
      grants it from Health Connect's own settings, two screens below the app's permission
      page. It is declared here because it still has to be, and SyncActivity walks the user
      there by hand.

      READ_HEALTH_DATA_HISTORY is not a fourth data type — it is a time window over the ones
      already declared. Without it Health Connect hands back only the last 30 days, which was
      not a guess: the first sync on a real device read exactly 30 days and Health Connect's
      own screen said "HoldMyTrack can read data added after August 17, 2026". A 30-day map is not
      what this product is; HoldMyTrack exists to show the accumulated shape of where someone has
      been, from history they already have. So this is asked for, and it is still the whole
      list — three permissions, one data type.
    -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE_ROUTES" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <!--
      In-app GPS recording (docs/adr/0007-in-app-gps-recording-submits-directly.md,
      apps/android/docs/ROADMAP.md Phase 7) — foreground-only, deliberately. Not
      ACCESS_BACKGROUND_LOCATION: that's a separately-reviewed permission with its own Play
      Store "prominent disclosure" burden, needed only if recording had to survive the app
      having no foreground presence at all. A declared foreground service with location type
      already keeps GPS running while the screen is off without it — background location is
      for access with *no* running foreground component, which this never is while recording.
      FOREGROUND_SERVICE_LOCATION (Android 14+) and POST_NOTIFICATIONS (Android 13+) are both
      required unconditionally at this app's minSdk 34, not optionally.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".HoldMyTrackApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.HoldMyTrack.Map">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: reached only from MainActivity's burger menu, never by another app. -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:label="@string/menu_profile"
            android:theme="@style/Theme.HoldMyTrack" />

        <!-- Not exported: reached only from MainActivity, never by another app. It keeps an
             action bar (Theme.HoldMyTrack, not the map's Theme.HoldMyTrack.Map) purely so
             it reads as a screen with a title rather than a form floating on nothing. -->
        <activity
            android:name=".SignInActivity"
            android:exported="false"
            android:label="@string/sign_in_title"
            android:theme="@style/Theme.HoldMyTrack" />

        <!-- Exported, unlike SignInActivity, because Health Connect itself launches it: the
             rationale intent below is how the platform shows the user why this app wants
             their exercise data, and without that filter the permission dialog can refuse to
             appear at all (found in the Phase 1 PoC). This screen is the rationale — it says
             what is read and what it is used for before asking for anything. -->
        <activity
            android:name=".SyncActivity"
            android:exported="true"
            android:label="@string/sync_title"
            android:theme="@style/Theme.HoldMyTrack">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SyncStatusActivity"
            android:exported="false"
            android:label="@string/status_title"
            android:theme="@style/Theme.HoldMyTrack" />

        <!-- Not exported: reached only from Recorded Activities' Edit, never by another app. -->
        <activity
            android:name=".recording.RecordingActivity"
            android:exported="false"
            android:label="@string/recording_edit_title"
            android:theme="@style/Theme.HoldMyTrack" />

        <!-- A foreground service so GPS keeps running while the screen is off — an ordinary
             background process is free game for the OS to kill, and a killed recording with
             no recovery is worse than the app not offering this at all. Started by the map's
             record button and by its own notification's Pause/Resume and Stop actions, all
             through explicit intents, so it never needs exporting. -->
        <service
            android:name=".recording.RecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Not exported: reached only from MainActivity's burger menu, never by another app. -->
        <activity
            android:name=".recording.RecordedActivitiesActivity"
            android:exported="false"
            android:label="@string/menu_recorded_activities"
            android:theme="@style/Theme.HoldMyTrack" />

        <!-- Where Health Connect's "see how this app used your data" link lands. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".SyncActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
