<?xml version="1.0" encoding="utf-8"?>
<!-- The selected activity's profile card, the web's .track-metric-toggle (MapView.tsx): bottom-left
     over the map, 240dp wide, on the map chrome's panel. A Pace / Heart rate toggle — only when the
     activity has heart rate, since a single-option control says nothing — then the profile strip
     and elevation curve (panel/TrackProfileView), then a line reading out the point under a touch,
     which keeps its height when empty so the card never jumps. MainActivity places it above the
     collapsed panel and shows it while an activity is selected. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/track_card"
    style="@style/Widget.HoldMyTrack.MapPanel"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|start"
    android:layout_marginStart="@dimen/hmt_space_10"
    android:clickable="true"
    android:focusable="false"
    android:orientation="vertical"
    android:padding="@dimen/hmt_space_8"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/track_metric_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/hmt_space_4"
        android:contentDescription="@string/panel_colored_by"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/track_metric_pace"
            style="@style/Widget.HoldMyTrack.Button.MapMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/panel_metric_pace" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/track_metric_hr"
            style="@style/Widget.HoldMyTrack.Button.MapMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hmt_space_2"
            android:text="@string/panel_metric_hr" />
    </LinearLayout>

    <dev.holdmytrack.android.panel.TrackProfileView
        android:id="@+id/track_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hmt_space_4"
        android:contentDescription="@string/panel_profile"
        android:minHeight="24dp" />

    <TextView
        android:id="@+id/track_readout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hmt_space_4"
        android:maxLines="1"
        android:minHeight="16dp"
        android:textColor="@color/hmt_ink_message"
        android:textSize="@dimen/hmt_text_xs" />
</LinearLayout>
