<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Hidden unless the map fails to load. A blank grey map is the single most common way
         this app will break — a wrong API origin, a stalled dev stack, an unreachable
         archive — and none of those say anything on screen by themselves. -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/hmt_ink"
        android:padding="12dp"
        android:textColor="@color/hmt_surface"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Floating chrome over the map, top-start: the burger menu above the map-mode toggle,
         mirroring the web client's own top-left mode control (apps/web/src/index.css's
         .map-mode-toggle) rather than a bar pinned along the bottom. Kept clear of MapLibre's
         own compass, which sits top-end. Styled from the theme (res/values/themes.xml). -->
    <LinearLayout
        android:id="@+id/top_start_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_button"
            style="@style/Widget.HoldMyTrack.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:backgroundTint="@color/hmt_map_chrome"
            android:contentDescription="@string/menu_button"
            android:minWidth="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/menu_button"
            app:strokeWidth="0dp" />

        <!-- Only shown to a signed-in account: all three layers the toggle switches between
             are behind requireAuth, so there is nothing for it to do without a session. -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/mode_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_map_chrome"
            android:elevation="2dp"
            android:padding="3dp"
            android:visibility="gone"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mode_normal"
                style="@style/Widget.HoldMyTrack.Button.MapMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_normal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mode_fog"
                style="@style/Widget.HoldMyTrack.Button.MapMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_fog" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mode_heatmap"
                style="@style/Widget.HoldMyTrack.Button.MapMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_heatmap" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <!-- One-tap GPS recording (MainActivity.onRecordTap): tap to start, tap again to pause or
         resume, hold for two seconds to stop (RecordButton draws the countdown ring). Translucent, bottom-centre, so it's reachable one-handed
         and the map still reads through it. The bottom margin is raised by the gesture bar's
         inset in MainActivity.insetSystemBars. -->
    <dev.holdmytrack.android.recording.RecordButton
        android:id="@+id/record_button"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_record_button"
        android:contentDescription="@string/record_button_start"
        android:padding="20dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_record_start" />
</FrameLayout>
