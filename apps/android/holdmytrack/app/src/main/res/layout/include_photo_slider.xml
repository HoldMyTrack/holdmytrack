<?xml version="1.0" encoding="utf-8"?>
<!-- A photo's place on the route (.photos-tab__slider): "Place on the route" with the time at
     the slider's point, and the slider — along the track by distance, 1,000 steps. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/hmt_space_8"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/photos_slider"
            android:textAppearance="@style/TextAppearance.HoldMyTrack.PanelFilterLabel" />

        <TextView
            android:id="@+id/photo_slider_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hmt_space_8"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/hmt_ink_meta"
            android:textSize="@dimen/hmt_text_xs"
            tools:text="16:10" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/photo_slider"
        style="@style/Widget.HoldMyTrack.PanelSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-8dp"
        android:layout_marginEnd="-8dp"
        android:contentDescription="@string/photos_slider"
        android:stepSize="1"
        android:valueFrom="0"
        android:valueTo="1000" />
</LinearLayout>
