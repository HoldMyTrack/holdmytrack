<?xml version="1.0" encoding="utf-8"?>
<!-- One sync history or duplicate row, a card's row (include_sync_history): on the left the name,
     one line, and under it a finished row's date and distance (.sync__detail); on the right the
     status, and under it View on map (.sync__map) for a row that became an activity. Filled by
     sync/ImportHistory. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/hmt_space_16"
    android:paddingTop="@dimen/hmt_space_10"
    android:paddingEnd="@dimen/hmt_space_16"
    android:paddingBottom="@dimen/hmt_space_10">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.HoldMyTrack.CardRowTitle" />

        <TextView
            android:id="@+id/row_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hmt_space_2"
            android:textAppearance="@style/TextAppearance.HoldMyTrack.CardRowSub"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Capped, so a long failure reason wraps in its own column instead of pushing the name
         off the row — the web's max-width: 60%, as a width in dp. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/hmt_space_8"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxWidth="220dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/hmt_ink_meta"
            android:textFontWeight="400" />

        <!-- The web's underlined accent text rather than a button, padded out to a 48dp
             touch target without changing how it reads. -->
        <TextView
            android:id="@+id/row_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:minHeight="48dp"
            android:gravity="end|center_vertical"
            android:text="@string/status_view_on_map"
            android:textColor="@color/hmt_accent_strong"
            android:textFontWeight="600"
            android:textSize="@dimen/hmt_text_2xs"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
