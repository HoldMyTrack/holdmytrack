<?xml version="1.0" encoding="utf-8"?>
<!-- DISTANCE's popup, under its chip in the Activities sheet (panel/ActivitiesPanel): the
     two-knob slider between the range's shortest and longest activity, those two under its
     ends. 288dp wide (ActivitiesPanel.showDistanceFilter). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel_popup"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingStart="@dimen/hmt_space_16"
    android:paddingTop="@dimen/hmt_space_12"
    android:paddingEnd="@dimen/hmt_space_16"
    android:paddingBottom="@dimen/hmt_space_12">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/panel_distance"
        android:textAppearance="@style/TextAppearance.HoldMyTrack.PanelFilterLabel" />

    <com.google.android.material.slider.RangeSlider
        android:id="@+id/panel_distance_slider"
        style="@style/Widget.HoldMyTrack.PanelSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-8dp"
        android:layout_marginEnd="-8dp"
        android:contentDescription="@string/panel_distance" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/panel_distance_min"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/panel_ink_40"
            android:textSize="@dimen/hmt_text_2xs"
            tools:text="1.2 km" />

        <TextView
            android:id="@+id/panel_distance_max"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/panel_ink_40"
            android:textSize="@dimen/hmt_text_2xs"
            tools:text="10.4 km" />
    </LinearLayout>
</LinearLayout>
