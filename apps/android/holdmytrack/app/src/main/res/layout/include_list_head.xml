<?xml version="1.0" encoding="utf-8"?>
<!-- A list's heading: a small uppercase title, and a summary at the other end — the web's
     .sync-tab__list-head. The includer sets the title's text; the summary is filled in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="true"
    android:orientation="horizontal"
    android:paddingBottom="@dimen/hmt_space_6">

    <TextView
        android:id="@+id/list_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:textAppearance="@style/TextAppearance.HoldMyTrack.Overline" />

    <TextView
        android:id="@+id/list_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/hmt_space_8"
        android:layout_weight="1"
        android:gravity="end"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="@color/hmt_ink_meta"
        android:textFontWeight="400" />
</LinearLayout>
