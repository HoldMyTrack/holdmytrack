<?xml version="1.0" encoding="utf-8"?>
<!-- After the web's Activities panel (.activity-filters, .activities-panel__list): two filter
     fields over the rows, the rows between hairlines, the demo notice in a notice box. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Drop-down fields, the same outlined field and chevron as the recording form's Type,
         rather than the platform Spinner, which draws in neither the theme's face nor its
         shapes. Not saved across recreation: the activity sets their labels itself, and a
         restored one would keep the old language's text after a language change. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/hmt_space_16">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.HoldMyTrack.Dropdown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/recorded_filter_status_label">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/recorded_filter_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.HoldMyTrack.Dropdown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hmt_space_8"
            android:layout_weight="1"
            android:hint="@string/recorded_filter_type_label">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/recorded_filter_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/recorded_demo_notice"
        style="@style/Widget.HoldMyTrack.Notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/hmt_space_16"
        android:layout_marginEnd="@dimen/hmt_space_16"
        android:layout_marginBottom="@dimen/hmt_space_16"
        android:text="@string/recorded_demo_notice"
        android:visibility="gone" />

    <TextView
        android:id="@+id/recorded_empty"
        style="@style/Widget.HoldMyTrack.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:padding="@dimen/hmt_space_24"
        android:text="@string/recorded_empty"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/recorded_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hmt_space_16"
            android:layout_marginEnd="@dimen/hmt_space_16"
            android:layout_marginBottom="@dimen/hmt_space_16"
            android:background="@drawable/bg_list_top"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
