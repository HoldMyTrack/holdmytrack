<?xml version="1.0" encoding="utf-8"?>
<!-- After the web's Sync tab history (.sync-tab__list-head, .sync-tab__rows): a list heading with
     its summary, then rows between hairlines; the duplicates as a second list of the same kind. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/hmt_space_16">

        <include
            android:id="@+id/status_head"
            layout="@layout/include_list_head" />

        <TextView
            android:id="@+id/status_error"
            style="@style/Widget.HoldMyTrack.Notice.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/hmt_space_8"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status_empty"
            style="@style/Widget.HoldMyTrack.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_summary_empty"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/status_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_list_top"
            android:orientation="vertical" />

        <!-- The web's .sync-tab__pager: the range on the left, earlier/later on the right. Only
             when the history runs past one page. -->
        <LinearLayout
            android:id="@+id/status_pager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hmt_space_4"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/status_range"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/hmt_ink_meta"
                android:textFontWeight="400" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/status_previous"
                style="@style/Widget.HoldMyTrack.Button.MapPage"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:contentDescription="@string/status_previous_page"
                app:icon="@drawable/ic_chevron_left" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/status_next"
                style="@style/Widget.HoldMyTrack.Button.MapPage"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hmt_space_4"
                android:contentDescription="@string/status_next_page"
                app:icon="@drawable/ic_chevron_right" />
        </LinearLayout>

        <!-- Hidden when there are none: an empty "Duplicates" heading invites the question of
             what is missing from under it. -->
        <include
            android:id="@+id/status_duplicates_head"
            layout="@layout/include_list_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hmt_space_24"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/status_duplicates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_list_top"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
