<?xml version="1.0" encoding="utf-8"?>
<!-- The map tab (MapFragment). A CoordinatorLayout so the Activities sheet at the bottom
     (include_activities_sheet) can be dragged between its heights; everything else is laid over
     the map as in a FrameLayout. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Photo markers (map/PhotoMarkers): views over the map, placed in code. The layer itself
         takes no touches, so the map pans and taps through it everywhere but on a marker. -->
    <FrameLayout
        android:id="@+id/photo_markers"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false" />

    <!-- A spot's popup (map/SpotPopup) and a photo's (map/PhotoPopup): over the map, under all
         of its chrome. -->
    <include layout="@layout/view_spot_popup" />

    <include layout="@layout/view_photo_popup" />

    <!-- The top of the map: the chrome row, and under it the one notice the map can show —
         checking the session, the server unreachable, the map failing to load, or nothing on
         it yet (MapFragment.showNotice). Neither takes touches outside its own panels, so the
         map still pans through the gaps. -->
    <LinearLayout
        android:id="@+id/top_chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- Floating chrome over the map, one row along the top. At the start, the map-mode
             toggle, mirroring the web client's own top-left mode control
             (apps/web/src/index.css's .map-mode-toggle) — or, while recording, the recording's
             status card in its place — with Show in this area under it. At the end, a rail of two
             round buttons: Layers, then Find my location, where the web has its geolocate
             control. MapLibre's compass, also top-end, is pushed below the row
             (MapFragment.applyCompassMargin). The row itself takes no touches, so the map still
             pans through the gaps. Styled from the theme (res/values/themes.xml). -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/hmt_space_12"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/hmt_space_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Only shown to a signed-in account: all three layers the toggle switches between
                     are behind requireAuth, so there is nothing for it to do without a session.
                     Plain checkable buttons, each an icon and its label — MapFragment.setMode
                     checks exactly one of the three.

                     It sits in a weighted scroll container rather than taking its own width first:
                     LinearLayout sizes weighted children last, so the rail always gets its own,
                     and at a large font size, where the three labels outgrow the row, the toggle
                     scrolls sideways instead of pushing the rail off the screen. -->
                <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingBottom="@dimen/hmt_space_4"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/mode_bar"
                        style="@style/Widget.HoldMyTrack.MapPanel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mode_normal"
                            style="@style/Widget.HoldMyTrack.Button.MapMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mode_normal"
                            app:icon="@drawable/ic_route" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mode_fog"
                            style="@style/Widget.HoldMyTrack.Button.MapMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/hmt_space_2"
                            android:text="@string/mode_fog"
                            app:icon="@drawable/ic_cloud_fog" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mode_heatmap"
                            style="@style/Widget.HoldMyTrack.Button.MapMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/hmt_space_2"
                            android:text="@string/mode_heatmap"
                            app:icon="@drawable/ic_flame" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- While a recording is in progress (MapFragment.renderRecordingStatus), the
                     recording's status in the mode toggle's place: a dot, the moving time large,
                     the distance or "Waiting for GPS…" before the first fix — and, during a hold on
                     the record button in the bottom bar, the stop countdown, where a finger on the
                     button can't hide it — and Stop, which asks first (MapFragment.confirmStop). -->
                <LinearLayout
                    android:id="@+id/recording_status"
                    style="@style/Widget.HoldMyTrack.MapPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/hmt_space_12"
                    android:visibility="gone">

                    <View
                        android:id="@+id/recording_status_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="@dimen/hmt_space_12"
                        android:background="@drawable/bg_recording_dot" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/hmt_space_4"
                        android:paddingBottom="@dimen/hmt_space_4">

                        <Chronometer
                            android:id="@+id/recording_status_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.HoldMyTrack.TitleLarge"
                            android:textColor="?android:attr/textColorPrimary" />

                        <TextView
                            android:id="@+id/recording_status_detail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.HoldMyTrack.BodyMedium"
                            android:textColor="?android:attr/textColorSecondary" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/recording_status_hold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/hmt_space_4"
                            android:max="1000"
                            android:visibility="gone"
                            app:indicatorColor="@color/hmt_record"
                            app:trackCornerRadius="2dp"
                            app:trackStopIndicatorSize="0dp"
                            app:trackThickness="4dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/recording_status_stop"
                        style="@style/Widget.HoldMyTrack.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/hmt_space_8"
                        android:text="@string/recording_stop" />
                </LinearLayout>

                <!-- "Show in this area" (map/ShowInArea): centred under the toggle, wrapping to a
                     second line rather than running under the rail. Gone outside zoom 10–13 and
                     with no place shown. -->
                <TextView
                    android:id="@+id/show_in_area"
                    style="@style/Widget.HoldMyTrack.ShowInArea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/hmt_space_8"
                    android:accessibilityLiveRegion="polite"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- The rail: Layers (map/LayersMenu) — its icon filled like the active mode while picks
                 show, with a badge on its corner counting them, opening the menu of paths, places,
                 the show-or-hide switch and Satellite — then Find my location
                 (MapFragment.onLocateTap), which shows the position dot and flies the camera to it,
                 the counterpart of the web map's geolocate control, hidden while recording, when
                 the camera already follows the recording. The rail steps aside while an editor
                 opens over the top of the map (MapFragment.renderRail). -->
            <LinearLayout
                android:id="@+id/map_rail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/layers_panel"
                    style="@style/Widget.HoldMyTrack.MapPanel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/hmt_space_8"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/layers_button"
                        style="@style/Widget.HoldMyTrack.Button.MapIcon.Toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/layers_button"
                        app:icon="@drawable/ic_layers" />

                    <TextView
                        android:id="@+id/layers_count"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="-6dp"
                        android:layout_marginEnd="-6dp"
                        android:background="@drawable/bg_layers_count"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:minWidth="16dp"
                        android:paddingStart="@dimen/hmt_space_4"
                        android:paddingEnd="@dimen/hmt_space_4"
                        android:textColor="@color/hmt_on_accent"
                        android:textSize="@dimen/hmt_text_3xs"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/locate_panel"
                    style="@style/Widget.HoldMyTrack.MapPanel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/locate_button"
                        style="@style/Widget.HoldMyTrack.Button.MapIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/locate_button"
                        app:icon="@drawable/ic_locate_fixed" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Which level Fog and Heatmap draw at (map/ZoomLevelNotice), the web's
             .zoom-level-notice: a line of its own under the top row, faded out a few seconds
             after it shows. Not clickable, so the map still takes touches through it. -->
        <TextView
            android:id="@+id/zoom_level_notice"
            style="@style/Widget.HoldMyTrack.ZoomLevelNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hmt_space_12"
            android:layout_marginEnd="@dimen/hmt_space_12"
            android:layout_marginBottom="@dimen/hmt_space_8"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <!-- The map's notice: the map chrome's own panel, after the web's on-map banner
             (.version-banner) — a message, a smaller detail line, and one action. -->
        <LinearLayout
            android:id="@+id/map_notice"
            style="@style/Widget.HoldMyTrack.MapPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hmt_space_12"
            android:layout_marginEnd="@dimen/hmt_space_12"
            android:accessibilityLiveRegion="polite"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/hmt_space_12"
            android:paddingEnd="@dimen/hmt_space_4"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingTop="@dimen/hmt_space_8"
                android:paddingBottom="@dimen/hmt_space_8">

                <TextView
                    android:id="@+id/map_notice_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineHeight="18sp" />

                <TextView
                    android:id="@+id/map_notice_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hmt_space_2"
                    android:textColor="@color/hmt_ink_meta"
                    android:textIsSelectable="true"
                    android:textSize="@dimen/hmt_text_2xs"
                    android:visibility="gone" />
            </LinearLayout>

            <Button
                android:id="@+id/map_notice_action"
                style="@style/Widget.HoldMyTrack.Button.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hmt_space_4"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Capture mode's banner (map/CaptureMode). -->
        <include layout="@layout/view_capture_banner" />
    </LinearLayout>

    <!-- The Edit window (include_edit_window, panel/EditActivityWindow), under the chrome row. -->
    <include layout="@layout/include_edit_window" />

    <!-- The Privacy tab's editor (include_private_location_editor, panel/PrivacyTab), where the
         Edit window would be. -->
    <include layout="@layout/include_private_location_editor" />

    <!-- Fog and Heatmap ignore the date range, so with the panel gone a chip at the bottom says
         what they show instead: every activity, or the last 365 days (MapFragment.renderModeChip).
         Centred, clear of MapLibre's logo and attribution at the start, and of the record button
         raised out of the bottom bar below it. -->
    <TextView
        android:id="@+id/mode_chip"
        style="@style/Widget.HoldMyTrack.ModeChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/hmt_space_32"
        android:visibility="gone" />

    <!-- The Activities sheet, Normal mode's alone, at the bottom of the map
         (include_activities_sheet, panel/ActivitiesPanel). -->
    <include layout="@layout/include_activities_sheet" />

    <!-- Laid over the collapsed sheet while the Edit window is open, taking every touch: the
         window edits the toolbar's target, which mustn't change underneath it, as the web makes
         the panel inert then. Its height follows the sheet's peek (MapFragment.placeEditLock). -->
    <View
        android:id="@+id/edit_lock"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:clickable="true"
        android:elevation="9dp"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
