<?xml version="1.0" encoding="utf-8"?>
<!-- Sync: what this phone sends, and what has come in. A card with one Sync now that sends all
     of it — Health Connect and the recordings on the device — then Health Connect's setup, the
     recordings waiting, the ways to bring in files from elsewhere, and the latest of the history
     (the web's /sync page), the whole of it a tap away (SyncHistoryActivity). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/gap_20"
        android:orientation="vertical"
        android:padding="@dimen/hmt_space_16"
        android:showDividers="middle">

        <!-- The screen's title, as the Sync tab of MainActivity; SyncActivity's action bar has its
             own (SyncFragment.onViewCreated). -->
        <TextView
            android:id="@+id/sync_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hmt_space_8"
            android:paddingStart="@dimen/hmt_space_4"
            android:paddingEnd="@dimen/hmt_space_4"
            android:text="@string/sync_title"
            android:textAppearance="@style/TextAppearance.HoldMyTrack.ScreenTitle" />

        <!-- Why nothing here can sync: signed out, email unconfirmed, or the read-only demo
             account (SyncFragment.render). -->
        <TextView
            android:id="@+id/sync_account_notice"
            style="@style/Widget.HoldMyTrack.Notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Sync now: what's waiting, the button, and what the run did — progress while it goes,
             then its summary, and what it couldn't do in the error box. Selectable, since a
             rejection's reason is exactly what someone would paste into a bug report. -->
        <LinearLayout
            android:id="@+id/sync_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_section_card"
            android:divider="@drawable/gap_12"
            android:orientation="vertical"
            android:paddingStart="@dimen/hmt_space_16"
            android:paddingTop="@dimen/hmt_space_16"
            android:paddingEnd="@dimen/hmt_space_16"
            android:paddingBottom="@dimen/hmt_space_16"
            android:showDividers="middle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sync_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.HoldMyTrack.TitleMedium" />

                <TextView
                    android:id="@+id/sync_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hmt_space_2"
                    android:textAppearance="@style/TextAppearance.HoldMyTrack.CardRowSub"
                    android:visibility="gone" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/sync_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/hmt_accent"
                app:trackColor="@color/hmt_surface_tint_strong"
                app:trackCornerRadius="2dp"
                app:trackThickness="4dp" />

            <Button
                android:id="@+id/sync_now"
                style="@style/Widget.HoldMyTrack.Button.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sync_now"
                app:icon="@drawable/ic_refresh_cw" />

            <TextView
                android:id="@+id/sync_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.HoldMyTrack.CardRowSub"
                android:textIsSelectable="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sync_problems"
                style="@style/Widget.HoldMyTrack.Notice.Error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Health Connect: a dot and a line for where its setup stands, the info button that
             opens the rationale (SyncFragment.showRationale) — which Health Connect itself asks
             this screen for — and the one step it still needs, if any. -->
        <LinearLayout
            android:id="@+id/sync_health_connect_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.HoldMyTrack.SectionHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/hmt_space_8"
                android:text="@string/sync_source_health_connect" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_section_card"
                android:orientation="vertical"
                android:paddingBottom="@dimen/hmt_space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/hmt_space_16"
                    android:paddingTop="@dimen/hmt_space_10"
                    android:paddingEnd="@dimen/hmt_space_4">

                    <View
                        android:id="@+id/sync_status_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="@dimen/hmt_space_16"
                        android:background="@drawable/bg_status_dot" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityLiveRegion="polite"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/sync_status_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.HoldMyTrack.CardRowTitle" />

                        <!-- Where Health Connect stands, said in full; in the danger color when
                             Health Connect couldn't be opened (SyncFragment.showStatus). -->
                        <TextView
                            android:id="@+id/sync_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/hmt_space_2"
                            android:textAppearance="@style/TextAppearance.HoldMyTrack.CardRowSub" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/sync_health_connect_info"
                        style="@style/Widget.HoldMyTrack.Button.RowIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/sync_health_connect_info"
                        app:icon="@drawable/ic_info"
                        app:iconTint="@color/hmt_ink_secondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/sync_instructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hmt_space_16"
                    android:layout_marginTop="@dimen/hmt_space_8"
                    android:layout_marginEnd="@dimen/hmt_space_16"
                    android:lineHeight="20sp"
                    android:textAppearance="@style/TextAppearance.HoldMyTrack.BodyMedium"
                    android:visibility="gone" />

                <!-- The next setup step, when there is one: allow access, open Health Connect. -->
                <Button
                    android:id="@+id/sync_primary"
                    style="@style/Widget.HoldMyTrack.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hmt_space_16"
                    android:layout_marginTop="@dimen/hmt_space_4"
                    android:layout_marginEnd="@dimen/hmt_space_16"
                    android:layout_marginBottom="@dimen/hmt_space_8"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Recorded on this phone: the GPS recordings that haven't synced yet, filled by
             RecordedActivityRows. -->
        <LinearLayout
            android:id="@+id/sync_recorded_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.HoldMyTrack.SectionHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/hmt_space_8"
                android:text="@string/sync_section_recorded" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_section_card"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sync_recorded_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/hmt_space_16"
                    android:text="@string/recorded_empty"
                    android:textAppearance="@style/TextAppearance.HoldMyTrack.CardRowSub"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/sync_recorded_rows"
                    style="@style/Widget.HoldMyTrack.SectionCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bring in files: Upload (UploadActivity) and Google Maps Timeline
             (TimelineImportActivity), files that come once rather than keep coming. Gone for an
             account that can't upload. -->
        <LinearLayout
            android:id="@+id/sync_files_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.HoldMyTrack.SectionHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/hmt_space_8"
                android:text="@string/sync_section_files" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/sync_upload"
                    style="@style/Widget.HoldMyTrack.Tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/hmt_space_10"
                    android:layout_weight="1">

                    <ImageView
                        style="@style/Widget.HoldMyTrack.IconTile"
                        android:contentDescription="@null"
                        android:backgroundTint="@color/hmt_accent_container"
                        android:src="@drawable/ic_upload"
                        app:tint="@color/hmt_accent_strong" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/hmt_space_10"
                        android:text="@string/sync_upload_title"
                        android:textAppearance="@style/TextAppearance.HoldMyTrack.TitleSmall" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/hmt_space_2"
                        android:text="@string/sync_upload_sub"
                        android:textAppearance="@style/TextAppearance.HoldMyTrack.BodySmall"
                        android:textColor="@color/hmt_ink_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sync_timeline"
                    style="@style/Widget.HoldMyTrack.Tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <ImageView
                        style="@style/Widget.HoldMyTrack.IconTile"
                        android:contentDescription="@null"
                        android:backgroundTint="@color/hmt_accent_container"
                        android:src="@drawable/ic_map_pin"
                        app:tint="@color/hmt_accent_strong" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/hmt_space_10"
                        android:text="@string/sync_timeline_title"
                        android:textAppearance="@style/TextAppearance.HoldMyTrack.TitleSmall" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/hmt_space_2"
                        android:text="@string/sync_timeline_sub"
                        android:textAppearance="@style/TextAppearance.HoldMyTrack.BodySmall"
                        android:textColor="@color/hmt_ink_secondary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- The latest of the sync history, and See all (SyncHistoryActivity) — every import
             from every source, a page at a time, and the duplicates. Filled by
             sync/ImportHistory. -->
        <LinearLayout
            android:id="@+id/sync_history_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/include_sync_history" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
