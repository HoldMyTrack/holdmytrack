<?xml version="1.0" encoding="utf-8"?>
<!-- One Photos tab row (panel/PhotosTab, the web's .photos-tab__row): the thumbnail, the caption
     or "Photo n", the time of its place on the route with New, Changed or Will be deleted, then
     Edit and Delete — or Keep this photo on one marked for deletion. Open, the slider and the
     caption under it, and Done. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/hmt_space_4"
    android:orientation="vertical"
    android:padding="@dimen/hmt_space_6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/photo_row_thumb"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_photo_frame"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hmt_space_10"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/photo_row_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/hmt_ink"
                android:textFontWeight="600"
                android:textSize="@dimen/hmt_text_md"
                tools:text="The view from the ridge" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/photo_row_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hmt_ink_secondary"
                    android:textSize="@dimen/hmt_text_sm"
                    tools:text="16:10" />

                <TextView
                    android:id="@+id/photo_row_badge"
                    style="@style/Widget.HoldMyTrack.PanelStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hmt_space_6"
                    android:visibility="gone"
                    tools:text="New"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/photo_row_edit"
            style="@style/Widget.HoldMyTrack.Button.RowIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/photos_edit"
            app:icon="@drawable/ic_pencil"
            app:iconSize="16dp" />

        <Button
            android:id="@+id/photo_row_delete"
            style="@style/Widget.HoldMyTrack.Button.RowIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/panel_delete_confirm"
            app:icon="@drawable/ic_trash_2"
            app:iconSize="16dp"
            app:iconTint="@color/hmt_danger" />

        <Button
            android:id="@+id/photo_row_undo"
            style="@style/Widget.HoldMyTrack.Button.RowIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/photos_undo_delete"
            android:visibility="gone"
            app:icon="@drawable/ic_undo_2"
            app:iconSize="16dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/photo_row_editor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <include
            android:id="@+id/photo_row_slider"
            layout="@layout/include_photo_slider" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/photo_row_caption_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hmt_space_6"
            android:hint="@string/photos_caption"
            app:counterMaxLength="500"
            app:placeholderText="@string/photos_caption_placeholder">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/photo_row_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="500" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/photo_row_done"
            style="@style/Widget.HoldMyTrack.Button.EditTrack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/hmt_space_6"
            android:text="@string/photos_done" />
    </LinearLayout>
</LinearLayout>
