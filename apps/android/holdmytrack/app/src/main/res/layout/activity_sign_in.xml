<?xml version="1.0" encoding="utf-8"?>
<!-- The web's sign-in and sign-up pages (templates/pages/signin.html, signup.html) as two modes
     of one card, which SignInActivity switches between: the serif title inside it, and the same
     order — providers, "or", the email form, then (sign-in only) the demo. The screen has no
     action bar (Theme.HoldMyTrack.NoActionBar); the card carries the title. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/hmt_space_16"
        android:paddingTop="@dimen/hmt_space_32"
        android:paddingEnd="@dimen/hmt_space_16"
        android:paddingBottom="@dimen/hmt_space_32">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.HoldMyTrack.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- The card's 16dp gap between everything, as the web's flex gap: 16px. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_16"
                android:orientation="vertical"
                android:showDividers="middle">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/sign_in_title"
                    android:textAppearance="?attr/textAppearanceTitleLarge" />

                <TextView
                    android:id="@+id/intro"
                    style="@style/Widget.HoldMyTrack.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sign_in_intro" />

                <!-- Hidden until GET /v1/auth/providers says the server has each configured
                     (SignInActivity), above the email form as on the web's sign-in page. -->
                <Button
                    android:id="@+id/google"
                    style="@style/Widget.HoldMyTrack.Button.Google"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/continue_with_google"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/facebook"
                    style="@style/Widget.HoldMyTrack.Button.Facebook"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/continue_with_facebook"
                    android:visibility="gone" />

                <include
                    android:id="@+id/providers_divider"
                    layout="@layout/include_or_divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:hint="@string/email_hint"
                        android:importantForAutofill="yes"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- The password and, on sign-in, "Forgot password?" under its right edge (the
                     web's .auth-card__forgot), grouped so the card's gap doesn't separate them. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="password"
                            android:hint="@string/password_hint"
                            android:importantForAutofill="yes"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/forgot"
                        style="@style/Widget.HoldMyTrack.Button.Link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="@string/forgot_password" />
                </LinearLayout>

                <!-- The server's own wording, verbatim — see SignInActivity for why it isn't
                     reworded on the way through — in the web's error box. -->
                <TextView
                    android:id="@+id/error"
                    style="@style/Widget.HoldMyTrack.Notice.Error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:visibility="gone" />

                <!-- Sign in or Create account, by mode, then the web's link to the other page. -->
                <Button
                    android:id="@+id/submit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sign_in" />

                <Button
                    android:id="@+id/switch_mode"
                    style="@style/Widget.HoldMyTrack.Button.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/to_sign_up" />

                <include
                    android:id="@+id/demo_divider"
                    layout="@layout/include_or_divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/demo"
                    style="@style/Widget.HoldMyTrack.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/try_demo"
                    app:backgroundTint="@color/hmt_surface" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</ScrollView>
