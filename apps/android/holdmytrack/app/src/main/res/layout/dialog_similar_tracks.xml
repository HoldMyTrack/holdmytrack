<?xml version="1.0" encoding="utf-8"?>
<!-- Similar tracks (sync/SimilarTracksDialog.kt), opened from a Sync row's ⓘ: which row it is,
     then what covers the same time — waiting on this phone, each picked out on the map when
     tapped, and already on the map, each opened on the Map tab — and that sending more than one
     makes two activities. Close is the dialog's own button. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/hmt_space_24"
        android:paddingTop="@dimen/hmt_space_4"
        android:paddingEnd="@dimen/hmt_space_24">

        <TextView
            android:id="@+id/similar_lead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/hmt_ink_secondary"
            android:textSize="@dimen/hmt_text_md" />

        <TextView
            android:id="@+id/similar_waiting_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hmt_space_16"
            android:layout_marginBottom="@dimen/hmt_space_4"
            android:accessibilityHeading="true"
            android:text="@string/similar_waiting"
            android:textAppearance="@style/TextAppearance.HoldMyTrack.PanelFilterLabel" />

        <LinearLayout
            android:id="@+id/similar_waiting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/similar_on_map_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hmt_space_16"
            android:layout_marginBottom="@dimen/hmt_space_4"
            android:accessibilityHeading="true"
            android:text="@string/similar_on_map"
            android:textAppearance="@style/TextAppearance.HoldMyTrack.PanelFilterLabel" />

        <LinearLayout
            android:id="@+id/similar_on_map"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hmt_space_16"
            android:text="@string/similar_note"
            android:textColor="@color/hmt_ink_secondary"
            android:textSize="@dimen/hmt_text_md" />
    </LinearLayout>
</ScrollView>