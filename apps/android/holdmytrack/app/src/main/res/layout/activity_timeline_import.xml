<?xml version="1.0" encoding="utf-8"?>
<!-- The Google Maps Timeline import (TimelineImportActivity): the web's TimelineImportWindow
     (apps/web/src/ui/TimelineImportWindow.tsx) as a screen. How to export and what stays on the
     phone until a file is read; then its days, From and To, one checkbox per mode, what the
     selection comes to, and Import. Laid out like the Sync screen: 16dp padding and gap, what's
     going on in a notice, what went wrong in the error box. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/gap_16"
        android:orientation="vertical"
        android:padding="@dimen/hmt_space_16"
        android:showDividers="middle">

        <!-- Why nothing here can be imported: signed out, email unconfirmed, or the demo. -->
        <TextView
            android:id="@+id/timeline_account_notice"
            style="@style/Widget.HoldMyTrack.Notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Before a file is read: how to export one, the step-by-step guide, and what's sent. -->
        <LinearLayout
            android:id="@+id/timeline_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/gap_8"
            android:orientation="vertical"
            android:showDividers="middle">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineHeight="20sp"
                android:text="@string/timeline_how" />

            <Button
                android:id="@+id/timeline_guide"
                style="@style/Widget.HoldMyTrack.Button.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/timeline_guide" />

            <TextView
                style="@style/Widget.HoldMyTrack.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/timeline_private" />
        </LinearLayout>

        <!-- The file read: its name and the days it spans. -->
        <TextView
            android:id="@+id/timeline_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.HoldMyTrack.TitleSmall"
            android:visibility="gone" />

        <Button
            android:id="@+id/timeline_choose"
            style="@style/Widget.HoldMyTrack.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/timeline_choose" />

        <!-- The selection: From and To, a checkbox per mode with its count and distance, and
             what it comes to. -->
        <LinearLayout
            android:id="@+id/timeline_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/gap_8"
            android:orientation="vertical"
            android:showDividers="middle"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/hmt_space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/timeline_from"
                        android:text="@string/timeline_from"
                        android:textAppearance="@style/TextAppearance.HoldMyTrack.Overline" />

                    <Button
                        android:id="@+id/timeline_from"
                        style="@style/Widget.HoldMyTrack.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/timeline_to"
                        android:text="@string/timeline_to"
                        android:textAppearance="@style/TextAppearance.HoldMyTrack.Overline" />

                    <Button
                        android:id="@+id/timeline_to"
                        style="@style/Widget.HoldMyTrack.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- One checkbox per mode, filled by TimelineImportActivity.renderModes. -->
            <LinearLayout
                android:id="@+id/timeline_modes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/timeline_skipped"
                style="@style/Widget.HoldMyTrack.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/timeline_selection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite" />
        </LinearLayout>

        <Button
            android:id="@+id/timeline_import"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/timeline_import"
            android:visibility="gone" />

        <!-- "Sending 300 of 584…", then what the send came to. -->
        <TextView
            android:id="@+id/timeline_progress"
            style="@style/Widget.HoldMyTrack.Notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <TextView
            android:id="@+id/timeline_error"
            style="@style/Widget.HoldMyTrack.Notice.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <Button
            android:id="@+id/timeline_close"
            style="@style/Widget.HoldMyTrack.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/timeline_close"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
