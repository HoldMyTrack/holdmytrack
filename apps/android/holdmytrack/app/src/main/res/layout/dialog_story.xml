<?xml version="1.0" encoding="utf-8"?>
<!-- Create story and Edit story (panel/StoryDialog.kt), after the web's StoryDialog.tsx: what the
     Story is made of (Create only), Name and Description, and the server's reason when a request
     fails. The dialog's own buttons are Cancel and Create story / Save. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/hmt_space_24"
    android:paddingTop="@dimen/hmt_space_4"
    android:paddingEnd="@dimen/hmt_space_24">

    <TextView
        android:id="@+id/story_dialog_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/hmt_space_8"
        android:textColor="@color/hmt_ink_secondary"
        android:textSize="@dimen/hmt_text_md" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/story_dialog_name_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/story_name"
        app:counterMaxLength="200"
        app:placeholderText="@string/story_name_placeholder">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/story_dialog_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLength="200" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/story_dialog_description_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hmt_space_10"
        android:hint="@string/story_description"
        app:placeholderText="@string/story_description_placeholder">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/story_dialog_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="2000"
            android:maxLines="6"
            android:minLines="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/story_dialog_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hmt_space_10"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/hmt_danger"
        android:textSize="@dimen/hmt_text_md"
        android:visibility="gone" />
</LinearLayout>
