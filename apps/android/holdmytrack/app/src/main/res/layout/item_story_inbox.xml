<?xml version="1.0" encoding="utf-8"?>
<!-- A copy of a Story someone sent, at the top of the Stories tab (the web's .stories-tab__inbox,
     docs/SPEC.md FR-14.6 item 13): who sent which Story and how many activities, then Accept and
     Decline — or, once accepted, "Copying …" with no buttons until it has arrived. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/hmt_accent_container"
    android:orientation="vertical"
    android:paddingStart="@dimen/hmt_space_16"
    android:paddingTop="@dimen/hmt_space_10"
    android:paddingEnd="@dimen/hmt_space_16"
    android:paddingBottom="@dimen/hmt_space_10">

    <TextView
        android:id="@+id/story_inbox_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/hmt_ink"
        android:textSize="@dimen/hmt_text_md"
        tools:text="Dad sent you a copy of “Vietnam” · 2 activities" />

    <LinearLayout
        android:id="@+id/story_inbox_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hmt_space_6"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/story_inbox_accept"
            style="@style/Widget.HoldMyTrack.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/story_inbox_accept" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/story_inbox_decline"
            style="@style/Widget.HoldMyTrack.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hmt_space_8"
            android:text="@string/story_inbox_decline" />
    </LinearLayout>
</LinearLayout>
