<?xml version="1.0" encoding="utf-8"?>
<!-- One Private location on the Privacy screen (PrivacyActivity): its circle as a picture, its
     name over its radius, and a chevron to the editor on the map — none for the demo account,
     which can't change it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.HoldMyTrack.CardRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="76dp"
    android:paddingStart="@dimen/hmt_space_12"
    android:paddingEnd="@dimen/hmt_space_12">

    <dev.holdmytrack.android.privacy.CirclePreviewView
        android:id="@+id/private_preview"
        android:layout_width="60dp"
        android:layout_height="52dp"
        android:layout_marginEnd="@dimen/hmt_space_16"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/private_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.HoldMyTrack.CardRowTitle" />

        <TextView
            android:id="@+id/private_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hmt_space_2"
            android:textAppearance="@style/TextAppearance.HoldMyTrack.CardRowSub" />
    </LinearLayout>

    <ImageView
        android:id="@+id/private_chevron"
        style="@style/Widget.HoldMyTrack.RowChevron"
        android:contentDescription="@null" />
</LinearLayout>
