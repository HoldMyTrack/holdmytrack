<?xml version="1.0" encoding="utf-8"?>
<!-- The Layers menu (.overlays-menu__panel), opened by the Layers button on the map's rail
     (map/LayersMenu): a switch that shows or hides every pick at once, Satellite where the served
     style has imagery, then Paths and Points of interest, each picked over any mode. It scrolls
     when it outgrows the screen (landscape). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="224dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel_popup"
    android:elevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/hmt_space_8">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/layers_master"
            style="@style/Widget.HoldMyTrack.LayersOption.Switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layers_master" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/layers_satellite"
            style="@style/Widget.HoldMyTrack.LayersOption.Switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layers_satellite"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/hmt_space_4"
            android:layout_marginBottom="@dimen/hmt_space_4"
            android:background="@color/hmt_border" />

        <TextView
            style="@style/Widget.HoldMyTrack.LayersLegend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/layers_paths" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/layers_bike_paths"
            style="@style/Widget.HoldMyTrack.LayersOption.Check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layers_bike_paths" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/layers_shared_paths"
            style="@style/Widget.HoldMyTrack.LayersOption.Check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layers_shared_paths" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/hmt_space_8"
            android:layout_marginBottom="@dimen/hmt_space_8"
            android:background="@color/hmt_border" />

        <TextView
            style="@style/Widget.HoldMyTrack.LayersLegend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/layers_places" />

        <!-- One per MapSpots.Category, in its order. -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/layers_spots_playground"
            style="@style/Widget.HoldMyTrack.LayersOption.Check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layers_playgrounds" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/layers_spots_dog_park"
            style="@style/Widget.HoldMyTrack.LayersOption.Check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layers_dog_parks" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/layers_spots_monument"
            style="@style/Widget.HoldMyTrack.LayersOption.Check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layers_monuments" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/layers_spots_viewpoint"
            style="@style/Widget.HoldMyTrack.LayersOption.Check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layers_viewpoints" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/layers_spots_history"
            style="@style/Widget.HoldMyTrack.LayersOption.Check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layers_history" />
    </LinearLayout>
</ScrollView>
