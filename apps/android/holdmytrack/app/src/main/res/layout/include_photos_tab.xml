<?xml version="1.0" encoding="utf-8"?>
<!-- The Edit window's Photos tab (panel/PhotosTab), after the web's PhotosTab.tsx: Add photos and
     how far preparing has got, an error line and the files that failed, the photo waiting for a
     place — its thumbnail, a slider along the route, Remove and Place here — then the list,
     capped in height so the map, where the photo being moved is drawn, stays in sight. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/edit_photos_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/hmt_space_12"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/photos_add"
            style="@style/Widget.HoldMyTrack.Button.EditTrack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/photos_add"
            app:icon="@drawable/ic_image_plus"
            app:iconPadding="@dimen/hmt_space_6"
            app:iconSize="16dp"
            app:iconTint="@color/edit_track_btn_text" />

        <TextView
            android:id="@+id/photos_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hmt_space_10"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/hmt_ink_secondary"
            android:textSize="@dimen/hmt_text_sm"
            android:visibility="gone"
            tools:text="Preparing 2 of 5…" />
    </LinearLayout>

    <TextView
        android:id="@+id/photos_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hmt_space_8"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/hmt_danger"
        android:textSize="@dimen/hmt_text_sm"
        android:visibility="gone" />

    <TextView
        android:id="@+id/photos_failures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hmt_space_8"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/hmt_danger"
        android:textSize="@dimen/hmt_text_sm"
        android:visibility="gone" />

    <!-- The photo waiting for a place (the web's waiting .photos-tab__row). -->
    <LinearLayout
        android:id="@+id/photos_waiting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hmt_space_8"
        android:background="@drawable/bg_photo_row_editing"
        android:orientation="vertical"
        android:padding="@dimen/hmt_space_6"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/photos_waiting_thumb"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_photo_frame"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hmt_space_10"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/photos_waiting_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textColor="@color/hmt_ink"
                    android:textFontWeight="600"
                    android:textSize="@dimen/hmt_text_md"
                    tools:text="PXL_20260924_161002.jpg" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/photos_needs_place"
                    android:textColor="@color/hmt_ink_secondary"
                    android:textSize="@dimen/hmt_text_sm" />
            </LinearLayout>
        </LinearLayout>

        <include
            android:id="@+id/photos_waiting_slider"
            layout="@layout/include_photo_slider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/photos_waiting_more"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/hmt_ink_secondary"
                android:textSize="@dimen/hmt_text_sm"
                tools:text="2 more to place" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/photos_waiting_remove"
                style="@style/Widget.HoldMyTrack.Button.EditTrack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/photos_remove" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/photos_waiting_place"
                style="@style/Widget.HoldMyTrack.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hmt_space_8"
                android:text="@string/photos_place_here" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/photos_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hmt_space_8"
        android:textColor="@color/hmt_ink_secondary"
        android:textSize="@dimen/hmt_text_sm"
        android:visibility="gone"
        tools:text="No photos yet." />

    <dev.holdmytrack.android.panel.MaxHeightScrollView
        android:id="@+id/photos_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hmt_space_4">

        <LinearLayout
            android:id="@+id/photos_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </dev.holdmytrack.android.panel.MaxHeightScrollView>
</LinearLayout>
