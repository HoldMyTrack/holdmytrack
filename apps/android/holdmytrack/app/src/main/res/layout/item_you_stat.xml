<?xml version="1.0" encoding="utf-8"?>
<!-- One of the You tab's four all-time numbers: the value in the serif, its label under it,
     a quarter of the card's width (fragment_you). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:paddingStart="0dp"
    android:paddingEnd="@dimen/hmt_space_8">

    <TextView
        android:id="@+id/stat_value"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:autoSizeMaxTextSize="22sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeTextType="uniform"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.HoldMyTrack.TitleLarge" />

    <TextView
        android:id="@+id/stat_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hmt_space_2"
        android:textAppearance="@style/TextAppearance.HoldMyTrack.BodySmall"
        android:textColor="@color/hmt_ink_secondary" />
</LinearLayout>
