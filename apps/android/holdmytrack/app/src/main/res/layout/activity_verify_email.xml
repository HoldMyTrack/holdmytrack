<?xml version="1.0" encoding="utf-8"?>
<!-- The web's /verify-pending page (templates/pages/verify-pending.html): the sign-in card again,
     with the address in the hint, a notice or an error box for what the last action said, and
     Sign out as the web's small link-button. No action bar; the card carries the title. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/hmt_space_16"
        android:paddingTop="@dimen/hmt_space_32"
        android:paddingEnd="@dimen/hmt_space_16"
        android:paddingBottom="@dimen/hmt_space_32">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.HoldMyTrack.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_16"
                android:orientation="vertical"
                android:showDividers="middle">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/verify_email_title"
                    android:textAppearance="?attr/textAppearanceTitleLarge" />

                <TextView
                    android:id="@+id/verify_hint"
                    style="@style/Widget.HoldMyTrack.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- What Continue or Resend just said: the server's confirmation, or "not
                     confirmed yet", in a notice; a failure in the error box. -->
                <TextView
                    android:id="@+id/verify_notice"
                    style="@style/Widget.HoldMyTrack.Notice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/verify_error"
                    style="@style/Widget.HoldMyTrack.Notice.Error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/verify_continue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/verify_email_continue" />

                    <Button
                        android:id="@+id/verify_resend"
                        style="@style/Widget.HoldMyTrack.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/verify_email_resend" />
                </LinearLayout>

                <Button
                    android:id="@+id/verify_sign_out"
                    style="@style/Widget.HoldMyTrack.Button.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/sign_out" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</ScrollView>
