<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="@dimen/hmt_space_24">

        <TextView
            android:id="@+id/verify_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/hmt_space_16"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <!-- Not yet confirmed, a failed check, or the server's answer to Resend. -->
        <TextView
            android:id="@+id/verify_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/hmt_space_12"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone" />

        <Button
            android:id="@+id/verify_continue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/verify_email_continue" />

        <Button
            android:id="@+id/verify_resend"
            style="@style/Widget.HoldMyTrack.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/verify_email_resend" />

        <Button
            android:id="@+id/verify_sign_out"
            style="@style/Widget.HoldMyTrack.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sign_out" />
    </LinearLayout>
</ScrollView>
