<?xml version="1.0" encoding="utf-8"?>
<!-- The sync history (the web's /sync list), filled by sync/ImportHistory: its heading with the
     count, then the rows in a card, a page at a time with the pager under them
     (SyncHistoryActivity). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/hmt_space_4"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:orientation="horizontal">

        <TextView
            style="@style/Widget.HoldMyTrack.SectionHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_history" />

        <TextView
            android:id="@+id/sync_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hmt_space_8"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/hmt_ink_meta"
            android:textFontWeight="400" />
    </LinearLayout>

    <TextView
        android:id="@+id/sync_error"
        style="@style/Widget.HoldMyTrack.Notice.Error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/hmt_space_8"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sync_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_section_card"
        android:padding="@dimen/hmt_space_16"
        android:text="@string/status_summary_empty"
        android:textAppearance="@style/TextAppearance.HoldMyTrack.CardRowSub"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/sync_rows"
        style="@style/Widget.HoldMyTrack.SectionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- The web's .sync__pager: ← Newer, the range, Older →, both buttons always in their
         places, the one with nowhere to go disabled. Only past one page. -->
    <LinearLayout
        android:id="@+id/sync_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hmt_space_4"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/sync_newer"
            style="@style/Widget.HoldMyTrack.Button.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_newer" />

        <TextView
            android:id="@+id/sync_range"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/hmt_ink_meta"
            android:textFontWeight="400" />

        <Button
            android:id="@+id/sync_older"
            style="@style/Widget.HoldMyTrack.Button.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_older" />
    </LinearLayout>
</merge>
