<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Health Connect opens this screen as the app's permission rationale, so this has to
             stand on its own as an answer to "why does this app want my exercise data". -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="@string/sync_rationale"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/sync_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sync_instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/sync_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <!-- A state-specific alternative to the primary action; only the 30-day-history state
             uses one so far ("sync what's reachable anyway"). -->
        <Button
            android:id="@+id/sync_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <Button
            android:id="@+id/sync_open_health_connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sync_open_health_connect" />

        <!-- Always available to a signed-in account, whatever the permission state: the
             history is worth reading precisely when a sync has not worked. -->
        <Button
            android:id="@+id/sync_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_history" />

        <TextView
            android:id="@+id/sync_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
