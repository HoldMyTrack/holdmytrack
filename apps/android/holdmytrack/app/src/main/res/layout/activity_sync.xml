<?xml version="1.0" encoding="utf-8"?>
<!-- After the web's Sync tab (apps/web/src/ui/SyncTab.tsx, .sync-tab in index.css): its 16dp
     padding and gap, the explanation as hint text, where things stand in a notice box, and what
     a run did in notices under the buttons that started it. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/gap_16"
        android:orientation="vertical"
        android:padding="@dimen/hmt_space_16"
        android:showDividers="middle">

        <!-- Health Connect opens this screen as the app's permission rationale, so this has to
             stand on its own as an answer to "why does this app want my exercise data". -->
        <TextView
            style="@style/Widget.HoldMyTrack.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sync_rationale" />

        <!-- Where things stand: ready, a permission missing, running. A notice, or the error
             box when Health Connect couldn't be opened (SyncActivity.showStatus). -->
        <TextView
            android:id="@+id/sync_status"
            style="@style/Widget.HoldMyTrack.Notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" />

        <TextView
            android:id="@+id/sync_instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineHeight="20sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/sync_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- A state-specific alternative to the primary action; only the 30-day-history
                 state uses one so far ("sync what's reachable anyway"). -->
            <Button
                android:id="@+id/sync_secondary"
                style="@style/Widget.HoldMyTrack.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <Button
                android:id="@+id/sync_open_health_connect"
                style="@style/Widget.HoldMyTrack.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sync_open_health_connect" />
        </LinearLayout>

        <!-- The run just finished: what it did in a notice, and what it couldn't — rejected
             activities, why it stopped, or the whole run failing — in the error box, the web's
             .sync-tab__notice and its error modifier. Selectable, since a rejection's reason is
             exactly what someone would paste into a bug report. -->
        <TextView
            android:id="@+id/sync_results"
            style="@style/Widget.HoldMyTrack.Notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sync_problems"
            style="@style/Widget.HoldMyTrack.Notice.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <!-- Always available to a signed-in account, whatever the permission state: the
             history is worth reading precisely when a sync has not worked. -->
        <Button
            android:id="@+id/sync_history"
            style="@style/Widget.HoldMyTrack.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_history" />
    </LinearLayout>
</ScrollView>
