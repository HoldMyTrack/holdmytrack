<?xml version="1.0" encoding="utf-8"?>
<!-- Sync: what this phone sends, and everything imported so far. Health Connect and the
     recordings on the device, one Sync now that sends all of it, files to upload, then the sync history and
     the duplicates, the web's /sync page (services/server/internal/web/templates/pages/sync.html)
     under it. 16dp padding and gap; where things stand in a notice box, and what a run did in
     notices under the button that started it. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/gap_16"
        android:orientation="vertical"
        android:padding="@dimen/hmt_space_16"
        android:showDividers="middle">

        <!-- Why nothing here can sync: signed out, email unconfirmed, or the read-only demo
             account (SyncActivity.render). -->
        <TextView
            android:id="@+id/sync_account_notice"
            style="@style/Widget.HoldMyTrack.Notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Health Connect: its title with an info button beside it, where its setup stands, and
             the one step it still needs, if any. The info button opens the rationale
             (SyncActivity.showRationale), which Health Connect itself asks this screen for. -->
        <LinearLayout
            android:id="@+id/sync_health_connect_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/gap_8"
            android:orientation="vertical"
            android:showDividers="middle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/sync_source_health_connect"
                    android:textAppearance="@style/TextAppearance.HoldMyTrack.Overline" />

                <Button
                    android:id="@+id/sync_health_connect_info"
                    style="@style/Widget.HoldMyTrack.Button.RowIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/sync_health_connect_info"
                    app:icon="@drawable/ic_info" />
            </LinearLayout>

            <!-- Where Health Connect stands: ready, a permission missing. A notice, or the error
                 box when Health Connect couldn't be opened (SyncActivity.showStatus). -->
            <TextView
                android:id="@+id/sync_status"
                style="@style/Widget.HoldMyTrack.Notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite" />

            <TextView
                android:id="@+id/sync_instructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineHeight="20sp"
                android:visibility="gone" />

            <!-- The next setup step, when there is one: allow access, open Health Connect. -->
            <Button
                android:id="@+id/sync_primary"
                style="@style/Widget.HoldMyTrack.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Recorded activities: the GPS recordings on this device that haven't synced yet,
             filled by RecordedActivityRows. -->
        <LinearLayout
            android:id="@+id/sync_recorded_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/hmt_space_8"
                android:accessibilityHeading="true"
                android:text="@string/sync_section_recorded"
                android:textAppearance="@style/TextAppearance.HoldMyTrack.Overline" />

            <TextView
                android:id="@+id/sync_recorded_empty"
                style="@style/Widget.HoldMyTrack.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recorded_empty"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/sync_recorded_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_list_top"
                android:orientation="vertical" />
        </LinearLayout>

        <Button
            android:id="@+id/sync_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sync_now" />

        <!-- The run: progress while it goes, then what it did in a notice, and what it couldn't
             — rejected activities, why it stopped, or the whole run failing — in the error box.
             Selectable, since a rejection's reason is exactly what someone would paste into a
             bug report. -->
        <TextView
            android:id="@+id/sync_results"
            style="@style/Widget.HoldMyTrack.Notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sync_problems"
            style="@style/Widget.HoldMyTrack.Notice.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <!-- Files: the web's Upload menu (services/server/internal/web/static/upload.js). What
             can be imported, the two step-by-step export guides, Choose files…, then each file
             queued or uploading, and what the uploads had to say. Filled by
             SyncActivity.renderFiles from imports/FileImports. -->
        <LinearLayout
            android:id="@+id/sync_files_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/gap_8"
            android:orientation="vertical"
            android:showDividers="middle"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/sync_section_files"
                android:textAppearance="@style/TextAppearance.HoldMyTrack.Overline" />

            <TextView
                style="@style/Widget.HoldMyTrack.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/upload_hint" />

            <Button
                android:id="@+id/sync_files_guide_google_health"
                style="@style/Widget.HoldMyTrack.Button.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upload_guide_google_health" />

            <Button
                android:id="@+id/sync_files_guide_timeline"
                style="@style/Widget.HoldMyTrack.Button.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upload_guide_timeline" />

            <Button
                android:id="@+id/sync_files_choose"
                style="@style/Widget.HoldMyTrack.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/upload_choose" />

            <!-- A row per file queued or uploading: its name, then "Queued" or "Uploading 45%". -->
            <LinearLayout
                android:id="@+id/sync_files_transfers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/sync_files_notes"
                style="@style/Widget.HoldMyTrack.Notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sync_files_errors"
                style="@style/Widget.HoldMyTrack.Notice.Error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:visibility="gone" />
        </LinearLayout>

        <!-- The sync history (the web's /sync list): every import from every source, newest
             first, a page at a time. Filled by sync/ImportHistory. -->
        <LinearLayout
            android:id="@+id/sync_history_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hmt_space_8"
            android:orientation="vertical">

            <include
                android:id="@+id/sync_head"
                layout="@layout/include_list_head" />

            <TextView
                android:id="@+id/sync_error"
                style="@style/Widget.HoldMyTrack.Notice.Error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/hmt_space_8"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sync_empty"
                style="@style/Widget.HoldMyTrack.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_summary_empty"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/sync_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_list_top"
                android:orientation="vertical" />

            <!-- The web's .sync__pager: ← Newer, the range, Older →, both buttons always in
                 their places, the one with nowhere to go disabled. Only past one page. -->
            <LinearLayout
                android:id="@+id/sync_pager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hmt_space_4"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/sync_newer"
                    style="@style/Widget.HoldMyTrack.Button.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_newer" />

                <TextView
                    android:id="@+id/sync_range"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/hmt_ink_meta"
                    android:textFontWeight="400" />

                <Button
                    android:id="@+id/sync_older"
                    style="@style/Widget.HoldMyTrack.Button.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_older" />
            </LinearLayout>
        </LinearLayout>

        <!-- The duplicates cross-source detection set aside (the web's /sync, under the history):
             gone when there are none. Filled by sync/ImportHistory. -->
        <LinearLayout
            android:id="@+id/sync_duplicates_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/duplicates_title"
                android:textAppearance="@style/TextAppearance.HoldMyTrack.Overline" />

            <TextView
                style="@style/Widget.HoldMyTrack.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hmt_space_4"
                android:layout_marginBottom="@dimen/hmt_space_8"
                android:text="@string/duplicates_subtext" />

            <LinearLayout
                android:id="@+id/sync_duplicates_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_list_top"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
