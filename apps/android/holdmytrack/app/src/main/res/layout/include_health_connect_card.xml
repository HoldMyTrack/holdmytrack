<?xml version="1.0" encoding="utf-8"?>
<!-- Health Connect: a dot and a line for where its setup stands, the info button that opens the
     rationale — which Health Connect itself asks for — and the one step it still needs, if any
     (sync/HealthConnectCard). On the Sync tab under the list, and the whole of SyncActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sync_health_connect_section"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Widget.HoldMyTrack.SectionHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/hmt_space_8"
        android:text="@string/sync_source_health_connect" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_section_card"
        android:orientation="vertical"
        android:paddingBottom="@dimen/hmt_space_4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/hmt_space_16"
            android:paddingTop="@dimen/hmt_space_10"
            android:paddingEnd="@dimen/hmt_space_4">

            <View
                android:id="@+id/sync_status_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="@dimen/hmt_space_16"
                android:background="@drawable/bg_status_dot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sync_status_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.HoldMyTrack.CardRowTitle" />

                <!-- Where Health Connect stands, said in full; in the danger color when
                     Health Connect couldn't be opened (sync/HealthConnectCard). -->
                <TextView
                    android:id="@+id/sync_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hmt_space_2"
                    android:textAppearance="@style/TextAppearance.HoldMyTrack.CardRowSub" />
            </LinearLayout>

            <Button
                android:id="@+id/sync_health_connect_info"
                style="@style/Widget.HoldMyTrack.Button.RowIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/sync_health_connect_info"
                app:icon="@drawable/ic_info"
                app:iconTint="@color/hmt_ink_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/sync_instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hmt_space_16"
            android:layout_marginTop="@dimen/hmt_space_8"
            android:layout_marginEnd="@dimen/hmt_space_16"
            android:lineHeight="20sp"
            android:textAppearance="@style/TextAppearance.HoldMyTrack.BodyMedium"
            android:visibility="gone" />

        <!-- The next setup step, when there is one: allow access, open Health Connect. -->
        <Button
            android:id="@+id/sync_primary"
            style="@style/Widget.HoldMyTrack.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hmt_space_16"
            android:layout_marginTop="@dimen/hmt_space_4"
            android:layout_marginEnd="@dimen/hmt_space_16"
            android:layout_marginBottom="@dimen/hmt_space_8"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
