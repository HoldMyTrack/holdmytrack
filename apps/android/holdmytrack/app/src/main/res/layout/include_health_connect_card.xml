<?xml version="1.0" encoding="utf-8"?>
<!-- Health Connect on Settings › Sync (SyncActivity, sync/HealthConnectCard): a dot and a line for
     where it stands, the info button that opens the rationale — which Health Connect itself asks
     for — and its on/off switch; what it reads; and, while it's on, its three permissions as a
     checklist, with the one step it still needs, if any. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sync_health_connect_section"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Widget.HoldMyTrack.SectionHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/hmt_space_8"
        android:text="@string/sync_source_health_connect" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_section_card"
        android:orientation="vertical"
        android:paddingBottom="@dimen/hmt_space_8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/hmt_space_16"
            android:paddingTop="@dimen/hmt_space_10"
            android:paddingEnd="@dimen/hmt_space_12">

            <View
                android:id="@+id/sync_status_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="@dimen/hmt_space_16"
                android:background="@drawable/bg_status_dot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sync_status_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.HoldMyTrack.CardRowTitle" />

                <!-- Where Health Connect stands, said in full; in the danger color when
                     Health Connect couldn't be opened (sync/HealthConnectCard). -->
                <TextView
                    android:id="@+id/sync_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hmt_space_2"
                    android:textAppearance="@style/TextAppearance.HoldMyTrack.CardRowSub" />
            </LinearLayout>

            <Button
                android:id="@+id/sync_health_connect_info"
                style="@style/Widget.HoldMyTrack.Button.RowIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/sync_health_connect_info"
                app:icon="@drawable/ic_info"
                app:iconTint="@color/hmt_ink_secondary" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sync_health_connect_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/sync_source_health_connect"
                android:minHeight="48dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hmt_space_16"
            android:layout_marginTop="@dimen/hmt_space_4"
            android:layout_marginEnd="@dimen/hmt_space_16"
            android:text="@string/sync_hc_reads"
            android:textAppearance="@style/TextAppearance.HoldMyTrack.CardRowSub" />

        <!-- While it's on: each permission ticked once granted (HealthConnectCard.renderChecklist). -->
        <LinearLayout
            android:id="@+id/sync_checklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hmt_space_16"
            android:layout_marginTop="@dimen/hmt_space_12"
            android:layout_marginEnd="@dimen/hmt_space_16"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/sync_check_sessions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/hmt_space_10"
                android:gravity="center_vertical"
                android:minHeight="32dp"
                android:text="@string/sync_check_sessions"
                android:textAppearance="@style/TextAppearance.HoldMyTrack.BodyMedium" />

            <TextView
                android:id="@+id/sync_check_routes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/hmt_space_10"
                android:gravity="center_vertical"
                android:minHeight="32dp"
                android:text="@string/sync_check_routes"
                android:textAppearance="@style/TextAppearance.HoldMyTrack.BodyMedium" />

            <TextView
                android:id="@+id/sync_check_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/hmt_space_10"
                android:gravity="center_vertical"
                android:minHeight="32dp"
                android:text="@string/sync_check_history"
                android:textAppearance="@style/TextAppearance.HoldMyTrack.BodyMedium" />
        </LinearLayout>

        <!-- The first load after switching on, read here when Health Connect is ready
             (SyncActivity): reading, then what it found. -->
        <TextView
            android:id="@+id/sync_first_load"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hmt_space_16"
            android:layout_marginTop="@dimen/hmt_space_8"
            android:layout_marginEnd="@dimen/hmt_space_16"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.HoldMyTrack.CardRowSub"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sync_instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hmt_space_16"
            android:layout_marginTop="@dimen/hmt_space_8"
            android:layout_marginEnd="@dimen/hmt_space_16"
            android:lineHeight="20sp"
            android:textAppearance="@style/TextAppearance.HoldMyTrack.BodyMedium"
            android:visibility="gone" />

        <!-- The next setup step, when there is one: allow access, open Health Connect. -->
        <Button
            android:id="@+id/sync_primary"
            style="@style/Widget.HoldMyTrack.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hmt_space_16"
            android:layout_marginTop="@dimen/hmt_space_8"
            android:layout_marginEnd="@dimen/hmt_space_16"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>