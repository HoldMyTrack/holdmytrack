<?xml version="1.0" encoding="utf-8"?>
<!-- The bottom of the Sync tab's list (panel/SyncTab): a note when there's nothing to list,
     Show hidden, then Health Connect's setup (include_health_connect_card), and two tiles side by
     side: Upload files (UploadActivity), gone for an account that can't upload, and Sync history
     (SyncHistoryActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:divider="@drawable/gap_20"
    android:orientation="vertical"
    android:paddingStart="@dimen/hmt_space_16"
    android:paddingTop="@dimen/hmt_space_8"
    android:paddingEnd="@dimen/hmt_space_16"
    android:paddingBottom="@dimen/hmt_space_16"
    android:showDividers="middle">

    <TextView
        android:id="@+id/sync_list_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.HoldMyTrack.CardRowSub"
        android:visibility="gone" />

    <Button
        android:id="@+id/sync_show_hidden"
        style="@style/Widget.HoldMyTrack.Button.Link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:textFontWeight="600"
        android:visibility="gone" />

    <include layout="@layout/include_health_connect_card" />

    <!-- Side by side, or one over the other at a large font size (LargeText.stack). -->
    <LinearLayout
        android:id="@+id/sync_tiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:divider="@drawable/gap_8_both"
        android:orientation="horizontal"
        android:showDividers="middle">

        <LinearLayout
            android:id="@+id/sync_upload"
            style="@style/Widget.HoldMyTrack.Tile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                style="@style/Widget.HoldMyTrack.IconTile"
                android:contentDescription="@null"
                android:backgroundTint="@color/hmt_accent_container"
                android:src="@drawable/ic_upload"
                app:tint="@color/hmt_accent_strong" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hmt_space_10"
                android:text="@string/sync_upload_title"
                android:textAppearance="@style/TextAppearance.HoldMyTrack.TitleSmall" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hmt_space_2"
                android:text="@string/sync_upload_sub"
                android:textAppearance="@style/TextAppearance.HoldMyTrack.BodySmall"
                android:textColor="@color/hmt_ink_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sync_history"
            style="@style/Widget.HoldMyTrack.Tile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                style="@style/Widget.HoldMyTrack.IconTile"
                android:contentDescription="@null"
                android:backgroundTint="@color/hmt_accent_container"
                android:src="@drawable/ic_history"
                app:tint="@color/hmt_accent_strong" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hmt_space_10"
                android:text="@string/sync_history_title"
                android:textAppearance="@style/TextAppearance.HoldMyTrack.TitleSmall" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hmt_space_2"
                android:text="@string/sync_history_sub"
                android:textAppearance="@style/TextAppearance.HoldMyTrack.BodySmall"
                android:textColor="@color/hmt_ink_secondary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
