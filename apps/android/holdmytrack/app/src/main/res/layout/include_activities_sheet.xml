<?xml version="1.0" encoding="utf-8"?>
<!-- The map's Activities sheet (panel/ActivitiesPanel.kt): a bottom sheet the user drags between
     collapsed — its head alone — half the map and nearly all of it (BottomSheetBehavior; the
     expanded top stops under the map's top row). Its head is the date range on the Activities
     tab — the range as a heading, ‹ › to move it, and the day scrubber under them — or the
     title of the Stories content showing instead. Everything under the
     head stays laid out while collapsed, just covered, so the list keeps its scroll position.
     Clickable, so a touch on it never reaches the map underneath. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activities_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sheet"
    android:clickable="true"
    android:contentDescription="@string/panel_label"
    android:elevation="8dp"
    android:focusable="false"
    android:orientation="vertical"
    android:visibility="gone"
    app:behavior_fitToContents="false"
    app:behavior_halfExpandedRatio="0.5"
    app:behavior_hideable="false"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <!-- Everything the collapsed sheet shows; its bottom edge is the peek height
         (ActivitiesPanel). Its bottom padding clears the record button, raised out of the bottom
         bar into the sheet's last few dp (activity_main.xml). -->
    <LinearLayout
        android:id="@+id/panel_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/hmt_space_20">

        <!-- The drag handle; a tap on it opens the sheet halfway, or closes it. -->
        <FrameLayout
            android:id="@+id/panel_handle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="-24dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/panel_expand">

            <!-- The bar is drawn in the top 24dp; the 48dp target reaches under the head's
                 first row, which takes no taps of its own. -->
            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_sheet_handle" />
        </FrameLayout>

        <!-- The Activities tab's head: the date range and the scrubber (map/DateRangeSlider),
             shown once there are activity days to pick from (MapFragment.renderDateFooter). -->
        <LinearLayout
            android:id="@+id/date_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/hmt_space_16"
                android:paddingEnd="@dimen/hmt_space_12">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/date_range_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.HoldMyTrack.TitleLarge"
                        tools:text="24 Sep – 3 Oct 2026" />

                    <TextView
                        android:id="@+id/panel_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/hmt_ink_meta"
                        android:textSize="@dimen/hmt_text_sm"
                        tools:text="6 activities · 74.8 km · 9h 6m" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/date_range_shift_earlier"
                    style="@style/Widget.HoldMyTrack.Button.SheetShift"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/date_range_shift_earlier"
                    app:icon="@drawable/ic_chevron_left" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/date_range_shift_later"
                    style="@style/Widget.HoldMyTrack.Button.SheetShift"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hmt_space_4"
                    android:contentDescription="@string/date_range_shift_later"
                    app:icon="@drawable/ic_chevron_right" />
            </LinearLayout>

            <dev.holdmytrack.android.map.DayScrubberView
                android:id="@+id/date_range_track"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hmt_space_10"
                android:paddingStart="@dimen/hmt_space_12"
                android:paddingEnd="@dimen/hmt_space_12" />
        </LinearLayout>

        <!-- The selected activity, in the range's place while one is selected. -->
        <include layout="@layout/include_activity_card" />

        <!-- The Stories head: the content's title. -->
        <LinearLayout
            android:id="@+id/panel_title_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/hmt_space_16"
            android:paddingEnd="@dimen/hmt_space_4"
            android:visibility="gone">

            <TextView
                android:id="@+id/panel_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.HoldMyTrack.TitleLarge"
                tools:text="Stories" />
        </LinearLayout>

        <!-- What the Stories content is (.activities-panel__subtext);
             the Activities tab has none, its range and filters saying what's listed. -->
        <TextView
            android:id="@+id/panel_subtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/hmt_space_16"
            android:paddingEnd="@dimen/hmt_space_16"
            android:textColor="@color/hmt_ink_meta"
            android:textSize="@dimen/hmt_text_sm"
            android:visibility="gone"
            tools:text="Hand-picked sets of your activities. Only you can see them." />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/hmt_hairline" />

    <!-- The tabs' contents, one showing at a time. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- The Activities tab: filters, toolbar, rows, footer. -->
        <LinearLayout
            android:id="@+id/panel_activities_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- The filters as chips (.activities-panel__filters): Type's dropdown, DISTANCE's
                 slider in a popup under its chip, "Reset" while either is on, and at the end Select,
                 which shows the rows' checkboxes and the selection bar over the map (Done ends it). -->
            <LinearLayout
                android:id="@+id/panel_filters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row_divider"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/hmt_space_16"
                android:paddingTop="@dimen/hmt_space_4"
                android:paddingEnd="@dimen/hmt_space_8"
                android:paddingBottom="@dimen/hmt_space_8">

                <LinearLayout
                    android:id="@+id/panel_type_trigger"
                    style="@style/Widget.HoldMyTrack.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/panel_filter_by_type">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/panel_type"
                        android:textAppearance="@style/TextAppearance.HoldMyTrack.FilterChip" />

                    <View
                        android:id="@+id/panel_type_dot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="@dimen/hmt_space_6"
                        android:background="@drawable/bg_panel_dot"
                        android:visibility="gone" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="@dimen/hmt_space_6"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/panel_ink_40" />
                </LinearLayout>

                <!-- DISTANCE (apps/web/src/ui/DistanceFilter.tsx): the chip reads the band, "any
                     distance" until a knob moves; gone when no two activities differ in distance,
                     as on the web. -->
                <LinearLayout
                    android:id="@+id/panel_distance"
                    style="@style/Widget.HoldMyTrack.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hmt_space_8"
                    android:contentDescription="@string/panel_distance">

                    <TextView
                        android:id="@+id/panel_distance_readout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.HoldMyTrack.FilterChip"
                        tools:text="any distance" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="@dimen/hmt_space_6"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/panel_ink_40" />
                </LinearLayout>

                <Button
                    android:id="@+id/panel_reset_filters"
                    style="@style/Widget.HoldMyTrack.Button.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hmt_space_4"
                    android:paddingStart="@dimen/hmt_space_8"
                    android:paddingEnd="@dimen/hmt_space_8"
                    android:text="@string/panel_reset"
                    android:textFontWeight="600"
                    android:textSize="@dimen/hmt_text_sm"
                    android:visibility="gone" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/panel_select"
                    style="@style/Widget.HoldMyTrack.Button.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/hmt_space_8"
                    android:paddingEnd="@dimen/hmt_space_8"
                    android:text="@string/panel_select"
                    android:textFontWeight="600"
                    android:textSize="@dimen/hmt_text_sm" />
            </LinearLayout>

            <!-- The rows, then a note while loading, when nothing matches, or when the read failed
                 (.activities-panel__note, item_panel_note). A tap on the list's own empty space, or on
                 the note, clears the selection (ActivitiesPanel.kt). -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/panel_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="vertical" />

            <!-- The target's summary (.activities-panel__footer): "1 selected · 10 km". -->
            <TextView
                android:id="@+id/panel_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_list_top"
                android:paddingStart="@dimen/hmt_space_16"
                android:paddingTop="@dimen/hmt_space_12"
                android:paddingEnd="@dimen/hmt_space_16"
                android:paddingBottom="@dimen/hmt_space_12"
                android:textColor="@color/hmt_ink_hint"
                android:textSize="@dimen/hmt_text_md"
                tools:text="1 selected · 10 km" />
        </LinearLayout>

        <!-- The Stories tab (apps/web/src/ui/StoriesTab.tsx): every Story as a folder, the open
             one's description and rows under it, then the open Story's statistics as the
             footer (.stories-tab__stats). Filled by panel/StoriesTab. -->
        <LinearLayout
            android:id="@+id/panel_stories_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/stories_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="never"
                android:scrollbars="vertical" />

            <LinearLayout
                android:id="@+id/stories_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_list_top"
                android:orientation="vertical"
                android:paddingStart="@dimen/hmt_space_16"
                android:paddingTop="@dimen/hmt_space_12"
                android:paddingEnd="@dimen/hmt_space_16"
                android:paddingBottom="@dimen/hmt_space_12"
                android:visibility="gone">

                <TextView
                    android:id="@+id/stories_stats_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hmt_ink"
                    android:textFontWeight="600"
                    android:textSize="@dimen/hmt_text_md"
                    tools:text="3 activities · 58 km · 3h 26m moving" />

                <!-- Per activity type (.stories-tab__types): its name, then its own line. -->
                <TableLayout
                    android:id="@+id/stories_types"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hmt_space_4"
                    android:contentDescription="@string/story_by_type"
                    android:shrinkColumns="1" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
