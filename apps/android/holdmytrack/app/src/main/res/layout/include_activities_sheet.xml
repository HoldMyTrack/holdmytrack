<?xml version="1.0" encoding="utf-8"?>
<!-- The map's Activities panel as the web draws it at phone width (apps/web/src/ui/ActivitiesPanel.tsx,
     the @media (max-width: 768px) layer of index.css): a sheet sitting on the date-range footer
     (activity_main's bottom_chrome draws the white, the hairline and the shadow for both),
     collapsed to the tab row and the "… loaded" line, and grown upward to most of the
     screen when that line is tapped (panel/ActivitiesPanel.kt sets the height). Everything under
     the line stays laid out while collapsed, just clipped, so the list keeps its scroll
     position. Clickable, so a touch on it never reaches the map underneath. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activities_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:contentDescription="@string/panel_label"
    android:focusable="false"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- The tab row (.activities-panel__head): the tab titles in the serif, the selected one
         underlined in the accent, a hairline under the row. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- The tabs (.activities-panel__tab): the selected one at full strength with the accent
             underline, the others dimmed. They scroll sideways when the three don't fit, as the
             web's tab strip does. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/hmt_space_16"
                android:paddingTop="@dimen/hmt_space_12"
                android:paddingEnd="@dimen/hmt_space_16">

                <LinearLayout
                    android:id="@+id/panel_tab_activities"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel_tab_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/hmt_space_6">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/panel_tab_activities"
                        android:textAppearance="@style/TextAppearance.HoldMyTrack.PanelTab" />

                    <TextView
                        android:id="@+id/panel_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/hmt_space_8"
                        android:background="@drawable/bg_panel_badge"
                        android:paddingStart="@dimen/hmt_space_8"
                        android:paddingTop="1dp"
                        android:paddingEnd="@dimen/hmt_space_8"
                        android:paddingBottom="1dp"
                        android:textColor="@color/hmt_accent_strong"
                        android:textFontWeight="700"
                        android:textSize="@dimen/hmt_text_sm"
                        tools:text="5" />
                </LinearLayout>

                <TextView
                    android:id="@+id/panel_tab_stories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hmt_space_20"
                    android:alpha="0.45"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingBottom="@dimen/hmt_space_6"
                    android:text="@string/panel_tab_stories"
                    android:textAppearance="@style/TextAppearance.HoldMyTrack.PanelTab" />

                <TextView
                    android:id="@+id/panel_tab_privacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hmt_space_20"
                    android:alpha="0.45"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingBottom="@dimen/hmt_space_6"
                    android:text="@string/panel_tab_privacy"
                    android:textAppearance="@style/TextAppearance.HoldMyTrack.PanelTab" />
            </LinearLayout>
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:background="@color/hmt_hairline" />
    </FrameLayout>

    <!-- "29 km loaded" and the chevron — the whole row is the sheet's expand/collapse toggle
         (.activities-panel__subtext), 48dp tall, a full touch target. Its bottom edge is the
         collapsed sheet's height (ActivitiesPanel.peekHeight). -->
    <LinearLayout
        android:id="@+id/panel_toggle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/hmt_space_16"
        android:paddingEnd="@dimen/hmt_space_16">

        <TextView
            android:id="@+id/panel_subtext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/hmt_ink_meta"
            android:textSize="@dimen/hmt_text_sm"
            tools:text="29 km loaded" />

        <ImageView
            android:id="@+id/panel_chevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_up"
            app:tint="@color/panel_ink_40" />
    </LinearLayout>

    <!-- The tabs' contents, one showing at a time. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- The Activities tab: filters, toolbar, rows, footer. -->
        <LinearLayout
            android:id="@+id/panel_activities_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- The two filters side by side (.activities-panel__filters): Type's dropdown, then the
                 DISTANCE slider taking the rest of the row, a hairline under both. -->
            <LinearLayout
                android:id="@+id/panel_filters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row_divider"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/hmt_space_16"
                android:paddingTop="@dimen/hmt_space_4"
                android:paddingEnd="@dimen/hmt_space_16"
                android:paddingBottom="@dimen/hmt_space_12">

                <LinearLayout
                    android:id="@+id/panel_type_trigger"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel_type_trigger"
                    android:clickable="true"
                    android:contentDescription="@string/panel_filter_by_type"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/hmt_space_10"
                    android:paddingEnd="@dimen/hmt_space_6">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/panel_type"
                        android:textAppearance="@style/TextAppearance.HoldMyTrack.TitleSmall" />

                    <View
                        android:id="@+id/panel_type_dot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="@dimen/hmt_space_8"
                        android:background="@drawable/bg_panel_dot"
                        android:visibility="gone" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="@dimen/hmt_space_8"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/panel_ink_40" />
                </LinearLayout>

                <!-- DISTANCE (apps/web/src/ui/DistanceFilter.tsx): the label and its readout, the
                     two-knob slider, the list's shortest and longest under its ends, and "Reset
                     filters" while either filter is on. Gone when no two activities differ in
                     distance, as on the web. -->
                <LinearLayout
                    android:id="@+id/panel_distance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hmt_space_16"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/panel_distance"
                            android:textAppearance="@style/TextAppearance.HoldMyTrack.PanelFilterLabel" />

                        <TextView
                            android:id="@+id/panel_distance_readout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/hmt_ink_meta"
                            android:textSize="@dimen/hmt_text_xs"
                            tools:text="any distance" />
                    </LinearLayout>

                    <com.google.android.material.slider.RangeSlider
                        android:id="@+id/panel_distance_slider"
                        style="@style/Widget.HoldMyTrack.PanelSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-8dp"
                        android:layout_marginEnd="-8dp"
                        android:contentDescription="@string/panel_distance" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/panel_distance_min"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/panel_ink_40"
                            android:textSize="@dimen/hmt_text_2xs"
                            tools:text="1.2 km" />

                        <TextView
                            android:id="@+id/panel_distance_max"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/panel_ink_40"
                            android:textSize="@dimen/hmt_text_2xs"
                            tools:text="10.4 km" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/panel_reset_filters"
                        style="@style/Widget.HoldMyTrack.Button.Link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="@string/panel_reset_filters"
                        android:textFontWeight="600"
                        android:textSize="@dimen/hmt_text_sm"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- The toolbar (.activities-panel__toolbar): the master checkbox and Invert, then the
                 actions over the toolbar's target, a divider, and the accent Focus on map. -->
            <LinearLayout
                android:id="@+id/panel_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row_divider"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/hmt_space_4"
                android:paddingEnd="@dimen/hmt_space_8">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/panel_check_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageButton
                    android:id="@+id/panel_invert"
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="-6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/panel_invert"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_invert"
                    app:tint="@color/panel_invert_icon" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/panel_visibility"
                    style="@style/Widget.HoldMyTrack.PanelChip"
                    android:contentDescription="@string/panel_no_target"
                    android:src="@drawable/ic_eye" />

                <ImageButton
                    android:id="@+id/panel_edit"
                    style="@style/Widget.HoldMyTrack.PanelChip"
                    android:contentDescription="@string/panel_no_target"
                    android:src="@drawable/ic_pencil" />

                <ImageButton
                    android:id="@+id/panel_create_story"
                    style="@style/Widget.HoldMyTrack.PanelChip"
                    android:contentDescription="@string/story_create_none"
                    android:src="@drawable/ic_book_plus" />

                <ImageButton
                    android:id="@+id/panel_delete"
                    style="@style/Widget.HoldMyTrack.PanelChip"
                    android:contentDescription="@string/panel_no_target"
                    android:src="@drawable/ic_trash_2" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="@dimen/hmt_space_4"
                    android:layout_marginEnd="@dimen/hmt_space_4"
                    android:background="@color/hmt_border" />

                <ImageButton
                    android:id="@+id/panel_focus"
                    style="@style/Widget.HoldMyTrack.PanelChip.Accent"
                    android:contentDescription="@string/panel_no_target"
                    android:src="@drawable/ic_focus" />
            </LinearLayout>

            <!-- The rows, then a note while loading, when nothing matches, or when the read failed
                 (.activities-panel__note, item_panel_note). A tap on the list's own empty space, or on
                 the note, clears the selection (ActivitiesPanel.kt). -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/panel_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="vertical" />

            <!-- The target's summary (.activities-panel__footer): "1 selected · 10 km". -->
            <TextView
                android:id="@+id/panel_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_list_top"
                android:paddingStart="@dimen/hmt_space_16"
                android:paddingTop="@dimen/hmt_space_12"
                android:paddingEnd="@dimen/hmt_space_16"
                android:paddingBottom="@dimen/hmt_space_12"
                android:textColor="@color/hmt_ink_hint"
                android:textSize="@dimen/hmt_text_md"
                tools:text="1 selected · 10 km" />
        </LinearLayout>

        <!-- The Stories tab (apps/web/src/ui/StoriesTab.tsx): every Story as a folder, the open
             one's description and rows under it, then the open Story's statistics as the
             footer (.stories-tab__stats). Filled by panel/StoriesTab. -->
        <LinearLayout
            android:id="@+id/panel_stories_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/stories_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="never"
                android:scrollbars="vertical" />

            <LinearLayout
                android:id="@+id/stories_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_list_top"
                android:orientation="vertical"
                android:paddingStart="@dimen/hmt_space_16"
                android:paddingTop="@dimen/hmt_space_12"
                android:paddingEnd="@dimen/hmt_space_16"
                android:paddingBottom="@dimen/hmt_space_12"
                android:visibility="gone">

                <TextView
                    android:id="@+id/stories_stats_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hmt_ink"
                    android:textFontWeight="600"
                    android:textSize="@dimen/hmt_text_md"
                    tools:text="3 activities · 58 km · 3h 26m moving" />

                <!-- Per activity type (.stories-tab__types): its name, then its own line. -->
                <TableLayout
                    android:id="@+id/stories_types"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hmt_space_4"
                    android:contentDescription="@string/story_by_type"
                    android:shrinkColumns="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- The Privacy tab (apps/web/src/ui/PrivateLocationsPanel.tsx), laid out as the
             Activities tab is: a toolbar strip with Create, the circles as rows, and a footer
             note. Filled by panel/PrivacyTab. -->
        <LinearLayout
            android:id="@+id/panel_privacy_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/privacy_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row_divider"
                android:orientation="horizontal"
                android:paddingStart="@dimen/hmt_space_16"
                android:paddingTop="@dimen/hmt_space_6"
                android:paddingEnd="@dimen/hmt_space_16"
                android:paddingBottom="@dimen/hmt_space_6">

                <Button
                    android:id="@+id/privacy_create"
                    style="@style/Widget.HoldMyTrack.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/private_create" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/privacy_rows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/privacy_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/hmt_space_16"
                        android:textColor="@color/panel_ink_50"
                        android:textSize="@dimen/hmt_text_md"
                        android:visibility="gone" />
                </LinearLayout>
            </ScrollView>

            <TextView
                android:id="@+id/privacy_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_list_top"
                android:paddingStart="@dimen/hmt_space_16"
                android:paddingTop="@dimen/hmt_space_12"
                android:paddingEnd="@dimen/hmt_space_16"
                android:paddingBottom="@dimen/hmt_space_12"
                android:text="@string/private_reprocess_note"
                android:textColor="@color/hmt_ink_meta"
                android:textSize="@dimen/hmt_text_sm" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
