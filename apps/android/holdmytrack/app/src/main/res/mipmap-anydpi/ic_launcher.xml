<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (minSdk 34, so no legacy per-density PNG icon is needed). The
     foreground is the HoldMyTrack logo, sized so its diagonal stays inside the 66dp safe
     zone every mask shape keeps; the background is the web app's cream page background. The
     monochrome layer is the logo's dark outline strokes, for Android 13+ themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
