<?xml version="1.0" encoding="utf-8"?>
<!-- The web client's light palette (services/server/internal/web/static/tokens.css, the fm-
     custom properties), carried over value for value so the two clients read as one product;
     res/values-night/colors.xml is its dark palette the same way. Provisional until root
     Phase 3's design freeze; that pass replaces these values in both files, and nothing else
     should need to change. A name added here needs its night value there too. -->
<resources>
    <color name="hmt_bg">#F7F4EC</color>
    <color name="hmt_surface">#FFFFFF</color>
    <color name="hmt_surface_tint">#F6F3E9</color>
    <color name="hmt_surface_tint_strong">#F1EEE3</color>
    <color name="hmt_divider_tint">#EFEAD9</color>

    <color name="hmt_ink">#202B25</color>
    <color name="hmt_ink_secondary">#6C7A70</color>
    <color name="hmt_ink_muted">#8B9186</color>
    <color name="hmt_ink_faint">#B7AF9A</color>
    <!-- Ink at 6%, 8% and 10% — the web's fm-ink-rgb hover, badge and hairline
         tints, which flip to a cream tint in the dark palette. -->
    <color name="hmt_ink_tint_6">#0F202B25</color>
    <color name="hmt_ink_tint_8">#14202B25</color>
    <color name="hmt_ink_tint_10">#1A202B25</color>

    <!-- Text on a filled accent: the web's fm-on-accent token. -->
    <color name="hmt_on_accent">#FFFFFF</color>

    <color name="hmt_border">#E6E1D2</color>
    <color name="hmt_border_strong">#DCD6C4</color>
    <color name="hmt_border_panel">#E2DCC8</color>

    <color name="hmt_accent">#B07E2E</color>
    <color name="hmt_accent_strong">#93691F</color>
    <color name="hmt_accent_hover">#8A611F</color>
    <color name="hmt_accent_container">#F3E6CE</color>

    <color name="hmt_danger">#AA3333</color>
    <color name="hmt_danger_container">#F6DEDA</color>
    <color name="hmt_success">#2F8A4E</color>

    <!-- Facebook's brand blue, for its sign-in button only (Meta's login-button guidelines). -->
    <color name="hmt_facebook">#1877F2</color>

    <!-- The floating map chrome's background: the web's rgb(255 255 255 / 92%). -->
    <color name="hmt_map_chrome">#EBFFFFFF</color>

    <!-- The record button's recording red and paused amber (bg_record_button_*.xml), for the
         status pill beside it — the same in both themes, as the button's are. -->
    <color name="hmt_record">#FFE53935</color>
    <color name="hmt_record_paused">#FFFFB300</color>
</resources>