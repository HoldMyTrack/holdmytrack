<?xml version="1.0" encoding="utf-8"?>
<!-- An Activities row, the web's .activities-panel__row: a hairline under it at ink 6%, and,
     selected, the accent at 8% with a 3dp strong-accent bar down its left edge
     (the web's selected-row modifier). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#14B07E2E" />
                </shape>
            </item>
            <item
                android:width="3dp"
                android:gravity="start">
                <shape>
                    <solid android:color="@color/hmt_accent_strong" />
                </shape>
            </item>
            <item
                android:height="1dp"
                android:gravity="bottom">
                <shape>
                    <solid android:color="@color/hmt_ink_tint_6" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:height="1dp"
                android:gravity="bottom">
                <shape>
                    <solid android:color="@color/hmt_ink_tint_6" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
