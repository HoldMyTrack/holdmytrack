<?xml version="1.0" encoding="utf-8"?>
<!-- The Activities sheet, the web's phone .activities-panel: white, with a hairline along its
     top edge (ink 10%). Its shadow is the view's elevation. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/hmt_surface" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:gravity="top">
        <shape>
            <solid android:color="#1A202B25" />
        </shape>
    </item>
</layer-list>
