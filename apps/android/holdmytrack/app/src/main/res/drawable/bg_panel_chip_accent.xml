<?xml version="1.0" encoding="utf-8"?>
<!-- Focus on map, the toolbar's main action, the web's .activities-panel__focus: the accent at
     12% (20% pressed), and the plain tint while disabled. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="7dp">
    <selector>
        <item android:state_enabled="false">
            <shape>
                <solid android:color="@color/hmt_surface_tint" />
                <corners android:radius="@dimen/hmt_radius_sm" />
            </shape>
        </item>
        <item android:state_pressed="true">
            <shape>
                <solid android:color="#33B07E2E" />
                <corners android:radius="@dimen/hmt_radius_sm" />
            </shape>
        </item>
        <item>
            <shape>
                <solid android:color="#1FB07E2E" />
                <corners android:radius="@dimen/hmt_radius_sm" />
            </shape>
        </item>
    </selector>
</inset>
