<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The map is served, not bundled: both the style document and every basemap tile come
         from the API. Health Connect permissions belong to Phase 3 and are not declared yet;
         asking for more than the app demonstrably uses is a known Play rejection cause. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".FitMapApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: reached only from MainActivity, never by another app. It keeps an
             action bar (the DayNight theme, not the NoActionBar one the map uses) purely so
             it reads as a screen with a title rather than a form floating on nothing. -->
        <activity
            android:name=".SignInActivity"
            android:exported="false"
            android:label="@string/sign_in_title"
            android:theme="@style/Theme.AppCompat.DayNight" />
    </application>
</manifest>
