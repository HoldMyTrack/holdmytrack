<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/recording_permission_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="@string/recording_needs_permission"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/recording_grant_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/recording_grant_permission"
            android:visibility="gone" />

        <EditText
            android:id="@+id/recording_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/recording_name_hint"
            android:inputType="text" />

        <Spinner
            android:id="@+id/recording_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/recording_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:hint="@string/recording_description_hint"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:columnCount="2"
            android:rowCount="2">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/recording_stat_time"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/recording_stat_distance"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/recording_stat_time_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/recording_stat_placeholder"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/recording_stat_distance_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/recording_stat_placeholder"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginTop="16dp"
                android:text="@string/recording_stat_altitude"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginTop="16dp"
                android:text="@string/recording_stat_speed"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/recording_stat_altitude_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/recording_stat_placeholder"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/recording_stat_speed_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/recording_stat_placeholder"
                android:textSize="20sp"
                android:textStyle="bold" />
        </GridLayout>

        <TextView
            android:id="@+id/recording_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/recording_record"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/recording_record" />

            <Button
                android:id="@+id/recording_pause_resume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/recording_pause"
                android:visibility="gone" />

            <Button
                android:id="@+id/recording_stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/recording_stop"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
