<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Hidden unless the map fails to load. A blank grey map is the single most common way
         this app will break — a wrong API origin, a stalled dev stack, an unreachable
         archive — and none of those say anything on screen by themselves. -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC000000"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
