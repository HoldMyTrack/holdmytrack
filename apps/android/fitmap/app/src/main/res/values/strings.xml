    <string name="sync_title">Sync from Health Connect</string>
    <string name="sync_rationale">FitMap reads your recorded exercise sessions and their GPS routes from Health Connect, and adds the outdoor ones to your map. It reads nothing else — no heart rate, no weight, no sleep — and it never writes anything back. Sessions recorded indoors have no route, so they are skipped.</string>
    <string name="sync_needs_account">Sign in to FitMap first — there is nowhere to sync to until then.</string>
    <string name="sync_unavailable">Health Connect isn\'t available on this device, so there is nothing to sync from.</string>
    <string name="sync_update_required">Health Connect needs updating before it can share anything.</string>
    <string name="sync_needs_exercise_permission">FitMap can\'t read your exercise sessions yet.</string>
    <string name="sync_needs_routes_permission">FitMap can read your sessions, but not their routes — and a session without a route has nothing to draw on the map. This one has to be granted inside Health Connect; it can\'t be requested from here.</string>
    <string name="sync_routes_steps">The button below opens Health Connect. Android only lets an app open its home screen, so from there:\n\n1. Tap App permissions\n2. Choose FitMap\n3. Scroll down to Additional access\n4. Tap Access exercise routes\n5. Choose Always allow\n\nThen come back here.</string>
