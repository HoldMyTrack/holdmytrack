# Reverse proxy + TLS + static frontend, for the minimal single-VPS deployment
# (docs/technical_implementation_plan.md's deployment section, DEPLOY.md).
#
# {$DOMAIN} is a real domain (e.g. holdmytrack.example.com), passed in via compose.prod.yml's
# `DOMAIN` env var — Caddy obtains and renews its own Let's Encrypt certificate for it
# automatically, no certbot/cron step required. Do not use "localhost" or an IP address
# here; Caddy only attempts ACME issuance for a real domain name.
#
# Frontend and API are deliberately served from this one origin rather than split across
# two — apps/web's production build (Dockerfile's `build` stage) already assumes this via
# VITE_API_BASE_URL="" (a same-origin relative API base), which is also why
# httpapi/server.go's corsAllowedOrigins needs no production entry added: a same-origin
# fetch is never a cross-origin request, so CORS never applies to it. Only reconsider that
# if the frontend and API are ever split onto different origins.
{$DOMAIN} {
	# Toggled via scripts/maintenance.sh (docs/DEPLOY.md), which flips MAINTENANCE_MODE in
	# .env.prod and recreates just this container. /healthz is deliberately exempt so it
	# keeps reflecting api/db's real status — that's what the script polls to know when
	# it's safe to turn this back off. `handle` blocks are mutually exclusive (first match
	# wins), so this short-circuits the static files and the Go server below whenever active.
	@maintenance {
		not path /healthz
		expression {env.MAINTENANCE_MODE} == "true"
	}
	handle @maintenance {
		# `respond` defaults to text/plain when no Content-Type is set, which would show
		# this markup as literal text instead of rendering it.
		header Content-Type "text/html; charset=utf-8"
		respond * `<!doctype html><meta charset="utf-8"><title>Down for maintenance</title>
<body style="font:1rem system-ui;text-align:center;padding:4rem 1rem"><h1>Be right back</h1>
<p>HoldMyTrack is down for scheduled maintenance. Try again in a few minutes.</p>` 503
	}

	# What the build and public/ put in /srv/web — the React app's bundle, the basemap archive
	# (when it's served from here rather than VITE_BASEMAP_ORIGIN), icons, robots.txt and the
	# sitemap — is served as files. Everything else is the Go server's: the API, the tiles, and
	# every page, the app's own shell included (ADR-0012), with its own 404 page for anything
	# it doesn't know. A new file in apps/web/public/ needs adding to this list. /download/* is
	# not from the build: it's a host directory bind-mounted in (compose.prod.yml), holding the
	# Android APK (docs/DEPLOY.md §10).
	@static path /assets/* /basemap/* /download/* /favicon.png /apple-touch-icon.png /robots.txt /sitemap.xml
	handle @static {
		root * /srv/web
		# The app's two entry files keep fixed names so the Go server can reference them
		# without this build's manifest (vite.config.ts); revalidate them every time, so a
		# deploy is never masked by a cached copy. Everything they load is content-hashed.
		header /assets/app.* Cache-Control "no-cache"
		# A new APK replaces the old one under the same name, so never serve a cached copy.
		header /download/* Cache-Control "no-cache"
		file_server
	}

	handle {
		reverse_proxy api:8080
	}

	encode gzip
}

# Every other name that should land on the app — www, plus any retired domains listed in
# REDIRECT_DOMAINS (space-separated, e.g. "olddomain.com www.olddomain.com") — gets a
# permanent redirect to {$DOMAIN}, keeping the path and query. Caddy issues a certificate
# for each name here too, so each one needs DNS pointed at this server or its ACME request
# keeps failing (the main site is unaffected; the failures just repeat in `logs web`).
# {$REDIRECT_DOMAINS} is substituted before parsing, so leaving it empty just drops it
# from the address list instead of producing an invalid one.
www.{$DOMAIN} {$REDIRECT_DOMAINS} {
	redir https://{$DOMAIN}{uri} permanent
}
