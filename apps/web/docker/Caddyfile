# Reverse proxy + TLS + static frontend, for the minimal single-VPS deployment
# (docs/technical_implementation_plan.md's deployment section, DEPLOY.md).
#
# {$DOMAIN} is a real domain (e.g. fitmap.example.com), passed in via compose.prod.yml's
# `DOMAIN` env var — Caddy obtains and renews its own Let's Encrypt certificate for it
# automatically, no certbot/cron step required. Do not use "localhost" or an IP address
# here; Caddy only attempts ACME issuance for a real domain name.
#
# Frontend and API are deliberately served from this one origin rather than split across
# two — apps/web's production build (Dockerfile's `build` stage) already assumes this via
# VITE_API_BASE_URL="" (a same-origin relative API base), which is also why
# httpapi/server.go's corsAllowedOrigins needs no production entry added: a same-origin
# fetch is never a cross-origin request, so CORS never applies to it. Only reconsider that
# if the frontend and API are ever split onto different origins.
{$DOMAIN} {
	# Toggled via scripts/maintenance.sh (docs/DEPLOY.md), which flips MAINTENANCE_MODE in
	# .env.prod and recreates just this container. /healthz is deliberately exempt so it
	# keeps reflecting api/db's real status — that's what the script polls to know when
	# it's safe to turn this back off. `handle` blocks are mutually exclusive (first match
	# wins), so this short-circuits @backend and the SPA fallback below whenever active.
	@maintenance {
		not path /healthz
		expression {env.MAINTENANCE_MODE} == "true"
	}
	handle @maintenance {
		# `respond` defaults to text/plain when no Content-Type is set, which would show
		# this markup as literal text instead of rendering it.
		header Content-Type "text/html; charset=utf-8"
		respond * `<!doctype html><meta charset="utf-8"><title>Down for maintenance</title>
<body style="font:1rem system-ui;text-align:center;padding:4rem 1rem"><h1>Be right back</h1>
<p>FitMap is down for scheduled maintenance. Try again in a few minutes.</p>` 503
	}

	@backend path /v1/* /tiles/* /healthz
	handle @backend {
		reverse_proxy api:8080
	}

	# The SPA fallback: any path that isn't the API and doesn't match a real file (e.g. a
	# deep link straight to a client-side route) still serves index.html, letting the
	# client-side app take over routing from there.
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	encode gzip
}
