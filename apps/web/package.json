{
  "name": "holdmytrack-web",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "basemap": "./scripts/build-basemap.sh",
    "build:style": "node scripts/build-style.mjs",
    "verify:style": "node scripts/build-style.mjs --check",
    "verify:map": "node --test tests/smoke.mjs",
    "verify:build": "node --test tests/build.mjs",
    "test:unit": "node --test tests/activityFacets.test.mjs tests/bbox.test.mjs tests/coveragePoll.test.mjs tests/editTrackOps.test.mjs tests/i18n.test.mjs tests/photoClusters.test.mjs tests/photoPrep.test.mjs tests/photoTrack.test.mjs tests/photoZoom.test.mjs tests/rangeShift.test.mjs tests/requestCredentials.test.mjs tests/timeZone.test.mjs tests/timelineReader.test.mjs",
    "test:coverage": "c8 npm run test:unit"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "lucide-react": "1.48.0",
    "maplibre-gl": "6.9.0",
    "pmtiles": "4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "c8": "12.0.0",
    "playwright": "1.63.0",
    "typescript": "~5.9.3",
    "vite": "8.3.0"
  }
}
