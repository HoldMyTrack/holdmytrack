# Copy to /.env.prod on the server (never commit the real file — see .gitignore) and fill
# in every value below. Used with:
#
#   docker compose -f compose.prod.yml --env-file .env.prod up -d
#
# Unlike .env.example (dev), nothing here has a working default baked into
# compose.prod.yml — a production deployment shouldn't silently run on a placeholder
# database password or a fake object-storage endpoint the way dev's RustFS stand-in can.

# --- Postgres ---
# Pick a real, unique password — this is a real database on a real public server, not
# dev's shared "holdmytrack"/"holdmytrack" pair.
POSTGRES_USER=holdmytrack
POSTGRES_PASSWORD=
POSTGRES_DB=holdmytrack

# --- Object storage: Cloudflare R2 (business_plan.md §4.3 — no egress fees, why R2 over
# S3) ---
# S3_ENDPOINT is the account-specific R2 endpoint, e.g.
# https://<account-id>.r2.cloudflarestorage.com — found on the R2 bucket's own settings
# page, not a fixed URL like dev's http://rustfs:9000.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Backups (scripts/backup.sh, scripts/restore-drill.sh — docs/DEPLOY.md §11) ---
# A second, private R2 bucket, never the app's own, with an R2 API token scoped to it alone
# (Object Read & Write). BACKUP_S3_ENDPOINT defaults to S3_ENDPOINT, which is right when both
# buckets are in the same Cloudflare account. BACKUP_DIR is where dumps are kept on this host.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_DIR=/srv/holdmytrack-backups

# --- Monitoring: Grafana Cloud (docs/DEPLOY.md §13, ADR-0030) ---
# Optional. COMPOSE_PROFILES=monitoring makes Compose start the `alloy` service, which ships
# logs and metrics to the stack below; leave it unset to run without. The URLs and usernames
# are on the stack's details page at grafana.com: Prometheus's remote-write URL (ending in
# /api/prom/push) and Loki's push URL (ending in /loki/api/v1/push) each have a username of
# their own. The token is an access policy token with only metrics:write and logs:write.
COMPOSE_PROFILES=
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_TOKEN=

# --- Outgoing mail (password reset — technical_implementation_plan.md §4.11) ---
# Leaving SMTP_HOST empty is a valid dev default (logs the reset link instead of sending
# it) but not a real production one — a live deployment's users need the actual email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- The app's own public address ---
# Must be the real https:// origin end users reach this at — auth.go's session cookie
# derives its Secure flag from this starting with "https://", and password-reset emails
# link back into it. Get this wrong (http://, a typo'd domain, a trailing slash) and
# sign-in or password reset breaks in ways that don't surface as a clear error.
APP_BASE_URL=https://

# --- Sign in with Google (optional — docs/DEPLOY.md, docs/SPEC.md FR-1.9) ---
# Leave GOOGLE_CLIENT_ID empty to run without it. When set, the OAuth client's authorized
# redirect URI must be exactly APP_BASE_URL + /v1/auth/google/callback. GOOGLE_REDIRECT_URL
# overrides that default and should stay empty here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# --- Sign in with Facebook (optional — docs/DEPLOY.md, docs/SPEC.md FR-1.10) ---
# Leave FACEBOOK_APP_ID empty to run without it. When set, the Meta app's Valid OAuth Redirect
# URIs must include exactly APP_BASE_URL + /v1/auth/facebook/callback. FACEBOOK_REDIRECT_URL
# overrides that default and should stay empty here. The App Secret is a password: keep it here
# only.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URL=

# --- Caddy (apps/web/docker/Caddyfile) ---
# The same domain as APP_BASE_URL, without the scheme — Caddy uses this to request and
# renew a Let's Encrypt certificate automatically. Must be a real domain with DNS already
# pointed at this server's IP; Caddy cannot issue a certificate for "localhost" or a bare
# IP address.
DOMAIN=

# Optional, space-separated: retired domains that should 301 to DOMAIN (e.g.
# "olddomain.com www.olddomain.com"). www.DOMAIN is always redirected and needs no entry
# here. Every name listed, www.DOMAIN included, needs DNS pointed at this server so Caddy
# can get it a certificate. Leave empty when there's nothing to redirect.
REDIRECT_DOMAINS=

# --- Maintenance mode (apps/web/docker/Caddyfile) ---
# Leave "false" normally. Flipped via `scripts/maintenance.sh on|off` (not by hand) around
# deploys that touch migrations or do manual DB work — see docs/DEPLOY.md.
MAINTENANCE_MODE=false

# --- Basemap origin ---
# The public R2 bucket/CDN origin serving basemap/basemap.pmtiles plus basemap/fonts and
# basemap/sprites, including the build's dated prefix (e.g.
# https://pub-xxxx.r2.dev/20260922, no trailing slash) — see DEPLOY.md §5. Also handed to
# the API as BASEMAP_ORIGIN for native clients' style document. Leave empty only when
# bind-mounting the archive into the web container instead (compose.prod.yml's commented
# volume line). Changing it needs a rebuild of the `web` image
# (`docker compose -f compose.prod.yml build web`) and an `up -d` for `api`.
VITE_BASEMAP_ORIGIN=

# --- Satellite imagery (optional; docs/SPEC.md FR-4.14, setup in DEPLOY.md) ---
# An XYZ tile template with the provider's key, its tile size in pixels, its deepest zoom,
# and the credit its terms require (HTML). Leave VITE_SATELLITE_TILES empty and there is no Satellite switch. Also
# handed to the API as SATELLITE_* for native clients' style document. Build-time for the
# `web` image, like VITE_BASEMAP_ORIGIN. holdmytrack.com uses MapTiler Satellite on the Free
# plan (100k tiles a month; imagery pauses, never bills, past that):
# VITE_SATELLITE_TILES=https://api.maptiler.com/tiles/satellite-v2/{z}/{x}/{y}.jpg?key=<key>
# VITE_SATELLITE_TILE_SIZE=512
# VITE_SATELLITE_MAXZOOM=18
# VITE_SATELLITE_ATTRIBUTION=<a href="https://www.maptiler.com/copyright/">© MapTiler</a>
VITE_SATELLITE_TILES=
VITE_SATELLITE_TILE_SIZE=512
VITE_SATELLITE_MAXZOOM=18
VITE_SATELLITE_ATTRIBUTION=

# --- Worker ---
# How many jobs the worker runs at once, never two of one account's (DEPLOY.md §4). The jobs
# mostly wait on R2, so this is bounded by memory, not CPUs: 4 is comfortable on 2 vCPU / 4 GB.
# Changing it needs only an `up -d` for `worker`.
WORKER_CONCURRENCY=4

# --- Uploads ---
# How many files one account may upload an hour (DEPLOY.md §4). Leave it at 100; raise it only
# while a load test seeds or imports. Changing it needs an `up -d` for `api`.
UPLOADS_PER_HOUR=100
