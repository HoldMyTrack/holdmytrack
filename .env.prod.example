# Copy to /.env.prod on the server (never commit the real file — see .gitignore) and fill
# in every value below. Used with:
#
#   docker compose -f compose.prod.yml --env-file .env.prod up -d
#
# Unlike .env.example (dev), nothing here has a working default baked into
# compose.prod.yml — a production deployment shouldn't silently run on a placeholder
# database password or a fake object-storage endpoint the way dev's MinIO stand-in can.

# --- Postgres ---
# Pick a real, unique password — this is a real database on a real public server, not
# dev's shared "holdmytrack"/"holdmytrack" pair.
POSTGRES_USER=holdmytrack
POSTGRES_PASSWORD=
POSTGRES_DB=holdmytrack

# --- Object storage: Cloudflare R2 (business_plan.md §4.3 — no egress fees, why R2 over
# S3) ---
# S3_ENDPOINT is the account-specific R2 endpoint, e.g.
# https://<account-id>.r2.cloudflarestorage.com — found on the R2 bucket's own settings
# page, not a fixed URL like MinIO's dev http://minio:9000.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Outgoing mail (password reset — technical_implementation_plan.md §4.11) ---
# Leaving SMTP_HOST empty is a valid dev default (logs the reset link instead of sending
# it) but not a real production one — a live deployment's users need the actual email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- The app's own public address ---
# Must be the real https:// origin end users reach this at — auth.go's session cookie
# derives its Secure flag from this starting with "https://", and password-reset emails
# link back into it. Get this wrong (http://, a typo'd domain, a trailing slash) and
# sign-in or password reset breaks in ways that don't surface as a clear error.
APP_BASE_URL=https://

# --- Sign in with Google (optional — docs/DEPLOY.md, docs/SPEC.md FR-1.9) ---
# Leave GOOGLE_CLIENT_ID empty to run without it. When set, the OAuth client's authorized
# redirect URI must be exactly APP_BASE_URL + /v1/auth/google/callback. GOOGLE_REDIRECT_URL
# overrides that default and should stay empty here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# --- Caddy (apps/web/docker/Caddyfile) ---
# The same domain as APP_BASE_URL, without the scheme — Caddy uses this to request and
# renew a Let's Encrypt certificate automatically. Must be a real domain with DNS already
# pointed at this server's IP; Caddy cannot issue a certificate for "localhost" or a bare
# IP address.
DOMAIN=

# Optional, space-separated: retired domains that should 301 to DOMAIN (e.g.
# "olddomain.com www.olddomain.com"). www.DOMAIN is always redirected and needs no entry
# here. Every name listed, www.DOMAIN included, needs DNS pointed at this server so Caddy
# can get it a certificate. Leave empty when there's nothing to redirect.
REDIRECT_DOMAINS=

# --- Maintenance mode (apps/web/docker/Caddyfile) ---
# Leave "false" normally. Flipped via `scripts/maintenance.sh on|off` (not by hand) around
# deploys that touch migrations or do manual DB work — see docs/DEPLOY.md.
MAINTENANCE_MODE=false

# --- Basemap origin ---
# The public R2 bucket/CDN origin serving basemap/basemap.pmtiles plus basemap/fonts and
# basemap/sprites, including the build's dated prefix (e.g.
# https://pub-xxxx.r2.dev/20260922, no trailing slash) — see DEPLOY.md §5. Also handed to
# the API as BASEMAP_ORIGIN for native clients' style document. Leave empty only when
# bind-mounting the archive into the web container instead (compose.prod.yml's commented
# volume line). Changing it needs a rebuild of the `web` image
# (`docker compose -f compose.prod.yml build web`) and an `up -d` for `api`.
VITE_BASEMAP_ORIGIN=
